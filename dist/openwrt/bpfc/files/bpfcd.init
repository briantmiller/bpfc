#!/bin/sh /etc/rc.common
# bpfcd: keeps the programs in /etc/bpfc/interfaces.d attached. Every
# /etc/bpfc/netns/<name>/ that has a bpfc.conf gets an instance of its own
# for network namespace <name> (bpfcd -n <name>; see bpfcd(8)).
#
#   /etc/init.d/bpfcd enable && /etc/init.d/bpfcd start
#   /etc/init.d/bpfcd reload       rescan the program files (new namespaces too)
#   logread -e bpfcd               its log

# Before the network (20), as packet filters usually are.
START=19
STOP=90
USE_PROCD=1
PROG=/usr/sbin/bpfcd

mount_bpffs() {
	grep -q ' /sys/fs/bpf bpf ' /proc/mounts && return 0
	mkdir -p /sys/fs/bpf 2>/dev/null
	mount -t bpf bpf /sys/fs/bpf ||
		logger -t bpfcd -p daemon.warn "cannot mount bpffs at /sys/fs/bpf: programs that use maps will fail"
}

instance() {
	procd_open_instance "$1"
	shift
	procd_set_param command "$PROG" "$@"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	mount_bpffs
	mkdir -p /var/run/bpfc /var/lib/bpfc
	instance main
	for d in /etc/bpfc/netns/*/; do
		[ -f "${d}bpfc.conf" ] || continue
		ns=${d%/}; ns=${ns##*/}
		instance "netns-$ns" -n "$ns"
	done
}

# Register the instances again (procd starts new namespaces' and stops
# removed ones', and leaves the others running), then have every bpfcd
# rescan its files.
reload_service() {
	start
	procd_send_signal bpfcd '*' HUP
}

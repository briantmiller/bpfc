# Direct links: fiber, copper, short point-to-point. Low loss, tiny RTT:
# ARQ repairs almost everything, FEC only when loss persists.
description = Direct link (fiber, cable, short point-to-point)
link-rate = 1g
rtt = 1ms
fec-threshold = 1
fec-cooldown = 10s
report-interval = 1000ms
congestion-delay = 20ms
arq-with-fec = 3

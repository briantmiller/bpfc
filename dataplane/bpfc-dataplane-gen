            get map $RX 74 PV;
            if PV gt %M1;
              set val M4 %M3;
              set val M3 %M2;
              set val M2 %M1;
              set val M1 %PV;
            else;
              if PV gt %M2;
                set val M4 %M3;
                set val M3 %M2;
                set val M2 %PV;
              else;
                if PV gt %M3;
                  set val M4 %M3;
                  set val M3 %PV;
                else;
                  if PV gt %M4;
                    set val M4 %PV;
                  end-if;
                end-if;
              end-if;
            end-if;
            get map $RX 75 PV;
            if PV gt %M1;
              set val M4 %M3;
              set val M3 %M2;
              set val M2 %M1;
              set val M1 %PV;
            else;
              if PV gt %M2;
                set val M4 %M3;
                set val M3 %M2;
                set val M2 %PV;
              else;
                if PV gt %M3;
                  set val M4 %M3;
                  set val M3 %PV;
                else;
                  if PV gt %M4;
                    set val M4 %PV;
                  end-if;
                end-if;
              end-if;
            end-if;
            # The four largest of the ring (53-56); the program that sends
            # our reports picks the estimate from them (19), out of this
            # program's verifier budget.
            set map $RX 53 %M1;
            set map $RX 54 %M2;
            set map $RX 55 %M3;
            set map $RX 56 %M4;
            calc-map add $RX 20 1;
            free PV;
            free M4;
            free M3;
            free M2;
            free M1;
            free PB;
          end-if;
        end-if;
      end-if;
      drop;
    end-if;
    free PN;
    free PS;
  end-if;
  free PF;
end-if;

if TY eq 5;
  get time NOW;
  calc div NOW 1000000;
  set map $TX 30 %NOW;
  calc-map add $TX 43 1;
  get src-mac PM;
  set map $TX 44 %PM;
  free PM;
  decl T 8;
  get bytes 22 8 V;
  set map $TX 31 %V;
  # loss in the last window (basis points), residual loss after FEC/ARQ
  get bytes 30 8 LOSS;
  set val V %LOSS;
  calc rsh V 32;
  set map $TX 33 %V;
  calc lsh LOSS 32;
  calc rsh LOSS 32;
  set map $TX 32 %LOSS;
  get bytes 38 8 V;
  set map $TX 34 %V;
  get bytes 46 8 V;
  set map $TX 35 %V;
  # RTT from the echoed timestamp: now - echoed ts - time the peer held it
  get bytes 54 8 V;
  set val T %V;
  calc rsh T 63;
  if T eq 1;
    get time NS;
    calc div NS 4000;
    set val T %V;
    calc rsh T 32;
    calc sub NS %T;
    calc and NS 0xFFFFFF;
    calc mul NS 4;
    calc lsh V 32;
    calc rsh V 32;
    if NS gt %V;
      calc sub NS %V;
      get map $TX 21 RTT;
      if RTT eq 0;
        set val RTT %NS;
      else;
        calc mul RTT 7;
        calc add RTT %NS;
        calc div RTT 8;
      end-if;
      set map $TX 21 %RTT;
      free RTT;
    end-if;
    free NS;
  end-if;
  get bytes 62 8 CAP;
  set map $TX 36 %CAP;
  get bytes 70 8 V;
  set val T %V;
  calc rsh T 32;
  set map $TX 37 %T;
  calc lsh V 32;
  calc rsh V 32;
  set map $TX 38 %V;
  get bytes 78 8 V;
  set val T %V;
  calc rsh T 32;
  set map $TX 39 %T;
  calc lsh V 32;
  calc rsh V 32;
  set map $TX 40 %V;
  get bytes 86 8 V;
  set map $TX 41 %V;
  get bytes 94 8 V;
  set map $TX 42 %V;
  get bytes 102 8 V;
  # A window of 2^32 packets or more is a wrapped one from a peer whose
  # sequence restarted (older versions): leave it out of the average.
  set val T %V;
  calc rsh T 32;
  if T ne 0;
    set val V 0;
  end-if;
  set map $TX 45 %V;
  # Loss estimate: average over the last loss-smoothing packets, weighted
  # by the packets each report covers (a report of 3 packets barely moves
  # it). Until that many have arrived it is the plain average so far.
  # 46 / 47 = loss / residual loss in 1/100 bp, 48 = packets averaged.
  if V gt 0;
    get map $CFG 17 SW;
    if SW eq 0;
      set val SW $LOSS_SMOOTH;
    end-if;
    get map $TX 48 SN;
    if SN gt %SW;
      set val SN %SW;
    end-if;
    decl SD 8;
    set val SD %SN;
    calc add SD %V;
    get map $TX 46 SL;
    calc mul SL %SN;
    set val T %LOSS;
    calc mul T 100;
    calc mul T %V;
    calc add SL %T;
    calc div SL %SD;
    set map $TX 46 %SL;
    get map $TX 33 SR;
    calc mul SR 100;
    calc mul SR %V;
    get map $TX 47 T;
    calc mul T %SN;
    calc add SR %T;
    calc div SR %SD;
    set map $TX 47 %SR;
    # 49 = last time the loss left after repair was 1 % or more (the
    # status tool's POOR line), for its hysteresis
    if SR ge 10000;
      set map $TX 49 %NOW;
    end-if;
    set val SN %SD;
    if SN gt %SW;
      set val SN %SW;
    end-if;
    set map $TX 48 %SN;
    free SR;
    free SD;
  end-if;
  # the controller acts on the estimate once a quarter of the packets are in
  get map $CFG 17 SW;
  if SW eq 0;
    set val SW $LOSS_SMOOTH;
  end-if;
  calc div SW 4;
  get map $TX 48 SN;
  get map $TX 46 SL;
  calc div SL 100;
  set val LOSS %SL;
  if SN lt %SW;
    set val LOSS 0;
  end-if;
  free SL;
  free SN;
  free SW;

  # Send rate since the last report (kbit/s = bytes * 8 / ms) and utilisation.
  get map $TX 19 LMS;
  get map $TX 3 B;
  get map $TX 20 LB;
  set map $TX 19 %NOW;
  set map $TX 20 %B;
  set val T %NOW;
  calc sub T %LMS;
  if LMS ne 0;
    if T gt 0;
      calc sub B %LB;
      calc mul B 8;
      calc div B %T;
      set map $TX 18 %B;
    end-if;
  end-if;
  free LB;
  free LMS;
  decl CONG 8;
  if CAP gt 0;
    get map $TX 18 B;
    calc mul B 100;
    calc div B %CAP;
    set map $TX 17 %B;
    get map $CFG 11 V;
    if V eq 0;
      set val V $CONG_PCT;
    end-if;
    if B ge %V;
      set val CONG 1;
    end-if;
  end-if;
  # Queueing delay reported by the peer: loss that comes with a growing
  # queue is congestion too (shapers can hide the bottleneck from probes).
  get map $TX 35 B;
  get map $CFG 15 V;
  if V eq 0;
    set val V $CONG_DELAY_MS;
  end-if;
  calc mul V 1000;
  if B ge %V;
    set val CONG 1;
  end-if;
  # Repair failing at full strength: FEC already sends its most parity
  # (k-min) and the loss left after FEC and ARQ is still at or above the
  # FEC threshold. More parity cannot fix that, and on a full link it adds
  # to the loss it repairs (seen as 20 % loss with 1:4 parity on an
  # overloaded 10 Mbit/s link): count it as congestion, so FEC uses the
  # fixed fec-k ratio. 50 = 1 while so; it holds until the loss left falls
  # below half the threshold or the loss itself below the threshold, since
  # the lighter ratio would otherwise end it at the next report.
  decl RF 8;
  get map $TX 50 RF;
  get map $CFG 1 T;
  if T eq 0;
    set val T $FEC_BP;
  end-if;
  get map $TX 47 B;
  calc div B 100;
  if RF eq 0;
    get map $TX 6 V;
    if V gt 0;
      get map $CFG 4 V2;
      if V2 eq 0;
        set val V2 $FEC_KMIN;
      end-if;
      if V le %V2;
        if B ge %T;
          set val RF 1;
        end-if;
      end-if;
    end-if;
  else;
    if LOSS lt %T;
      set val RF 0;
    end-if;
    calc mul B 2;
    if B lt %T;
      set val RF 0;
    end-if;
  end-if;
  set map $TX 50 %RF;
  if RF eq 1;
    set val CONG 1;
  end-if;
  free RF;
  free V2;
  set map $TX 16 %CONG;
  free B;
  free CAP;

  # FEC controller. 6 = parity ratio K in use (0 = off), 7 = last time loss
  # was at or above the threshold, 8 = on/off changes, 22 = on since.
  get map $TX 6 FK;
  decl NK 8;
  set val NK %FK;
  # mode: 1 = off, 2 = on, 0 or 3 = automatic
  get map $CFG 14 V;
  if V eq 0;
    set val V $FEC_FORCE;
  end-if;
  if V eq 3;
    set val V 0;
  end-if;
  if V eq 1;
    set val NK 0;
  end-if;
  if V eq 2;
    get map $CFG 3 NK;
    if NK eq 0;
      set val NK $FEC_K;
    end-if;
  end-if;
  if V eq 0;
    get map $CFG 1 V;
    if V eq 0;
      set val V $FEC_BP;
    end-if;
    if LOSS ge %V;
      set map $TX 7 %NOW;
      if CONG eq 1;
        get map $CFG 3 NK;
        if NK eq 0;
          set val NK $FEC_K;
        end-if;
      else;
        # one parity per K packets with K = 1 / (4 * loss), within limits
        set val NK 2500;
        calc div NK %LOSS;
        get map $CFG 4 V;
        if V eq 0;
          set val V $FEC_KMIN;
        end-if;
        if NK lt %V;
          set val NK %V;
        end-if;
        get map $CFG 5 V;
        if V eq 0;
          set val V $FEC_KMAX;
        end-if;
        if NK gt %V;
          set val NK %V;
        end-if;
      end-if;
    else;
      if FK gt 0;
        get map $TX 7 V;
        set val T %NOW;
        calc sub T %V;
        get map $CFG 2 V;
        if V eq 0;
          set val V $COOLDOWN_MS;
        end-if;
        if T ge %V;
          set val NK 0;
        end-if;
      end-if;
    end-if;
    # floor: FEC never below 1 parity per FLOOR packets (cfg 16 = 16: no floor)
    get map $CFG 16 V;
    if V eq 0;
      set val V $FEC_FLOOR;
    end-if;
    if V gt 0;
      if V le 15;
        if NK eq 0;
          set val NK %V;
        end-if;
        if NK gt %V;
          set val NK %V;
        end-if;
      end-if;
    end-if;
  end-if;
  if NK gt 15;
    set val NK 15;
  end-if;
  if NK ne %FK;
    set map $TX 6 %NK;
    if FK eq 0;
      calc-map add $TX 8 1;
      set map $TX 22 %NOW;
    end-if;
    if NK eq 0;
      calc-map add $TX 8 1;
    end-if;
  end-if;
  free NK;
  free FK;
  free CONG;
  free LOSS;
  free V;
  free T;
  free NOW;
  drop;
end-if;

if TY eq 4;
  calc-map add $TX 12 1;
  decl CNT 8;
  set val CNT %W;
  calc rsh CNT 48;
  calc and CNT 0xFF;
  decl S 8;
  set val S %W;
  calc rsh S 32;
  calc and S 0xFFFF;
  # how far back we answer: the whole ring, or less (or nothing) while FEC is on
  decl LIM 8;
  set val LIM $ARQ_DEPTH;
  get map $TX 6 FK;
  if FK gt 0;
    get map $CFG 8 V;
    if V eq 0;
      set val V $ARQ_MODE;
    end-if;
    if V eq 2;
      calc-map add $TX 15 %CNT;
      drop;
    end-if;
    if V eq 3;
      get map $CFG 9 LIM;
      if LIM eq 0;
        set val LIM $ARQ_FEC_DEPTH;
      end-if;
      if LIM gt $ARQ_DEPTH;
        set val LIM $ARQ_DEPTH;
      end-if;
    end-if;
  end-if;
  if CNT eq 0;
    drop;
  end-if;
  if CNT gt $NAK_MAX;
    set val CNT $NAK_MAX;
  end-if;
  get map $TX 1 CUR;
  get dst-mac DM;
  get src-mac SM;
  set dst-mac %SM;
  set src-mac %DM;
  free SM;
  free DM;
  get skb-ifindex IFX;
  decl AGE 8;
  decl T 8;
  start-loop;
    # age 1 = the last packet sent; seq = next seq - age
    set val AGE %CUR;
    calc sub AGE %S;
    calc and AGE 0xFFFF;
    if AGE eq 0;
      calc-map add $TX 14 1;
    else;
      if AGE gt %LIM;
        if AGE le $ARQ_DEPTH;
          calc-map add $TX 15 1;
        else;
          calc-map add $TX 14 1;
        end-if;
      else;
        set val V %CUR;
        calc sub V %AGE;
        set val T %V;
        calc mod T $ARQ_DEPTH;
        get map $ATAG %T TAG;
        set val AGE %TAG;
        calc rsh AGE 16;
        if AGE eq %V;
          calc and TAG 0xFFFF;
          set val V %TAG;
          calc add V 14;
          set len %V;
          load-packet-keyed $ARQ %T %TAG 0 14;
          # type 3 (retransmission), probe flags cleared
          get bytes 14 8 RW;
          calc lsh RW 3;
          calc rsh RW 3;
          set val V 0x0C;
          calc lsh V 56;
          calc not V;
          calc and RW %V;
          set val V 3;
          calc lsh V 61;
          calc or RW %V;
          calc hton RW 64;
          set bytes 14 8 %RW;
          clone %IFX egress;
          calc-map add $TX 13 1;
        else;
          calc-map add $TX 14 1;
        end-if;
      end-if;
    end-if;
    calc add S 1;
    calc and S 0xFFFF;
    calc sub CNT 1;
  loop CNT;
  drop;
end-if;
continue;
EOF
} | emit ingress $P_CTRL "control"

# dup_clear <indent>: zero every word of the duplicate bitmap.
dup_clear() {
cat <<EOF | sed "s/^/$1/"
decl DK 8;
set val DK $DUP_WORDS;
start-loop;
  calc sub DK 1;
  set map $DUP %DK 0;
loop DK;
free DK;
EOF
}

# Duplicate check for a received or recovered sequence number.
# In: S (16-bit seq). Out: S32 (extended seq), DUPV = 1 if already seen.
# The bitmap ($DUP, $DUP_WORDS words of 64 seqs) is valid for the word of the
# highest seq and the next one; older than 960 or further ahead is not checked.
dedupe_snippet() {
cat <<EOF
get map $RX 1 H;
decl S32 8;
decl DUPV 8;
decl T 8;
if H ne 0;
  calc sub H 1;
  set val S32 %S;
  calc sub S32 %H;
  calc and S32 0xFFFF;
  if S32 lt 0x8000;
    calc add S32 %H;
  else;
    set val T 0x10000;
    calc sub T %S32;
    set val S32 %H;
    calc sub S32 %T;
  end-if;
  decl CHK 8;
  set val CHK 1;
  if S32 le %H;
    set val T %H;
    calc sub T %S32;
    if T ge $DUP_OLD;
      set val CHK 0;
    end-if;
  else;
    set val T %S32;
    calc rsh T 6;
    calc rsh H 6;
    calc sub T %H;
    if T ge 2;
      set val CHK 0;
    end-if;
  end-if;
  if CHK eq 1;
    set val CHK %S32;
    calc rsh CHK 6;
    calc and CHK $((DUP_WORDS - 1));
    set val T %S32;
    calc and T 63;
    set val H 1;
    calc lsh H %T;
    calc-map or $DUP %CHK %H OLD;
    calc and OLD %H;
    if OLD ne 0;
      set val DUPV 1;
    end-if;
    free OLD;
  end-if;
  free CHK;
end-if;
free H;
EOF
}

########################################################################
# Ingress, second: parity frames. If exactly one member of the block is
# missing, rebuild it from the parity and the members received.
########################################################################
{
cat <<EOF
$HEADER
shared-buffer-map $FRX $FEC_SLOTS 1504;
array-map $FSL $((FEC_SLOTS * 4));
array-map $DUP $DUP_WORDS;
match eth-proto 0x88B5;
get bytes 14 8 W;
decl TY 8;
set val TY %W;
calc rsh TY 61;
if TY ne 2;
  continue;
end-if;
free TY;
calc-map add $RX 9 1;
# receive slot = block & (slots - 1); $FSL keys slot*4: +0 block+1, +1 members, +2 seq-xor
decl SL 8;
set val SL %W;
calc rsh SL 24;
calc and SL 0xFF;
decl KB 8;
set val KB %SL;
calc and KB $((FEC_SLOTS - 1));
calc mul KB 4;
get map $FSL %KB TAG;
calc add SL 1;
if TAG ne %SL;
  calc-map add $RX 8 1;
  drop;
end-if;
free TAG;
set val SL %KB;
calc div SL 4;
set map $FSL %KB 0;
calc add KB 1;
get map $FSL %KB CNT;
calc add KB 1;
get map $FSL %KB RXX;
free KB;
decl N 8;
set val N %W;
calc rsh N 48;
calc and N 0xF;
if CNT eq %N;
  zero-buffer-keyed $FRX %SL 1504 0;
  drop;
end-if;
calc add CNT 1;
if CNT ne %N;
  calc-map add $RX 8 1;
  zero-buffer-keyed $FRX %SL 1504 0;
  drop;
end-if;
free CNT;
free N;

# Put back the two bytes the sender's checksum offload may have overwritten.
decl CB 8;
set val CB %W;
calc rsh CB 32;
calc and CB 0xFFFF;
calc hton CB 16;
decl CODE 8;
set val CODE %W;
calc rsh CODE 16;
calc and CODE 0xFF;
if CODE eq 2;
  set bytes 58 2 %CB;
end-if;
if CODE eq 1;
  set bytes 48 2 %CB;
end-if;
free CODE;
free CB;

# missing packet = parity xor received members
get len PL;
calc sub PL 22;
xor-packet-keyed $FRX %SL %PL 22 0;
load-packet-keyed $FRX %SL %PL 0 22;
zero-buffer-keyed $FRX %SL 1504 0;
free SL;
$( [ "$CARRIER" = udp-inline ] && cat <<EOC
# udp-inline: the members were folded without TOS, TTL and checksum; take
# TOS and TTL from the parity frame (as it arrived) and compute the checksum.
get skb-cb 3 QC;
decl QV 8;
set val QV %QC;
free QC;
decl QM 8;
set val QM %QV;
calc rsh QM 16;
if QM ne 0xB5A1;
  set val QV 64;
  calc lsh QV 8;
end-if;
get bytes 22 8 RA;
get bytes 30 8 RB;
get bytes 38 4 RC;
decl CS 8;
decl CT 8;
decl QX 8;
set val QX %QV;
calc and QX 0xFF;
calc lsh QX 48;
calc or RA %QX;
set val QX %QV;
calc rsh QX 8;
calc and QX 0xFF;
calc lsh QX 56;
calc or RB %QX;
$(csum_add RA 64)
$(csum_add RB 64)
$(csum_add RC 32)
$(csum_fold)
calc lsh CS 32;
calc or RB %CS;
calc hton RA 64;
calc hton RB 64;
set bytes 22 8 %RA;
set bytes 30 8 %RB;
free QX;
free CT;
free CS;
free RC;
free RB;
free RA;
free QM;
free QV;
EOC
)

# Check it is a sane IPv4 header with a valid header checksum.
get bytes 22 1 VI;
if VI ne 0x45;
  calc-map add $RX 34 1;
  drop;
end-if;
free VI;
get bytes 24 2 TL;
if TL lt 20;
  calc-map add $RX 34 1;
  drop;
end-if;
if TL gt %PL;
  calc-map add $RX 34 1;
  drop;
end-if;
decl SUM 8;
decl T 8;
get bytes 22 8 A;
set val T %A;
calc rsh T 48;
calc add SUM %T;
set val T %A;
calc rsh T 32;
calc and T 0xFFFF;
calc add SUM %T;
set val T %A;
calc rsh T 16;
calc and T 0xFFFF;
calc add SUM %T;
calc and A 0xFFFF;
calc add SUM %A;
get bytes 30 8 A;
set val T %A;
calc rsh T 48;
calc add SUM %T;
set val T %A;
calc rsh T 32;
calc and T 0xFFFF;
calc add SUM %T;
set val T %A;
calc rsh T 16;
calc and T 0xFFFF;
calc add SUM %T;
calc and A 0xFFFF;
calc add SUM %A;
free A;
get bytes 38 4 C;
set val T %C;
calc rsh T 16;
calc add SUM %T;
calc and C 0xFFFF;
calc add SUM %C;
free C;
set val T %SUM;
calc rsh T 16;
calc and SUM 0xFFFF;
calc add SUM %T;
set val T %SUM;
calc rsh T 16;
calc and SUM 0xFFFF;
calc add SUM %T;
if SUM ne 0xFFFF;
  calc-map add $RX 34 1;
  drop;
end-if;
free SUM;
free T;

# seq of the missing packet = parity seq-xor ^ received seq-xor
decl S 8;
set val S %W;
calc and S 0xFFFF;
calc xor S %RXX;
calc and S 0xFFFF;
free RXX;
EOF
dedupe_snippet
cat <<EOF
if DUPV eq 1;
  calc-map add $RX 37 1;
  drop;
end-if;
decl L 8;
set val L %TL;
calc add L 22;
set len %L;
free L;
strip-l2 8 0x0800;
# The rebuilt packet carries its real TCP/UDP checksum: check it here so a bad
# rebuild is counted and dropped instead of delivered.
get bytes 20 2 FR;
calc and FR 0x3FFF;
if FR eq 0;
  get bytes 23 1 PR;
  if PR eq 6;
    calc-csum tcp CV 14 1500;
    get bytes 50 2 CF;
    if CV ne %CF;
      calc-map add $RX 34 1;
      drop;
    end-if;
  end-if;
  if PR eq 17;
    get bytes 40 2 CF;
    if CF ne 0;
      calc-csum udp CV 14 1500;
      if CV ne %CF;
        calc-map add $RX 34 1;
        drop;
      end-if;
    end-if;
  end-if;
end-if;
calc-map add $RX 6 1;
accept;
EOF
} | emit ingress $P_PARITY "parity"

########################################################################
# Ingress, third: data and retransmissions from the peer. Sequence, loss,
# duplicates and reordering; jitter and relative one-way delay; probe pairs;
# FEC accumulation; decapsulation; NAKs and periodic reports to the peer.
########################################################################
{
cat <<EOF
$HEADER
shared-buffer-map $FRX $FEC_SLOTS 1504;
array-map $FSL $((FEC_SLOTS * 4));
array-map $DUP $DUP_WORDS;
match eth-proto 0x88B5;
get bytes 14 8 W;
decl TY 8;
set val TY %W;
calc rsh TY 61;
if TY ne 1;
  if TY ne 3;
    drop;
  end-if;
end-if;
get time NOW;
decl FL 8;
set val FL %W;
calc rsh FL 56;
calc and FL 0x1F;
decl S 8;
set val S %W;
calc rsh S 32;
calc and S 0xFFFF;
decl T 8;

# Sequence: extend to 64 bits around the highest seen (key 1 = highest + 1).
get map $RX 1 HP;
decl S32 8;
decl HH 8;
decl GAP 8;
decl NEW 8;
if HP eq 0;
  set val S32 %S;
  set val NEW 1;
  # where this receiver started (key 58): see the restart check below
  set map $RX 58 %S32;
EOF
dup_clear "  "
cat <<EOF
else;
  set val HH %HP;
  calc sub HH 1;
  set val S32 %S;
  calc sub S32 %HH;
  calc and S32 0xFFFF;
  if S32 eq 0;
    set val S32 %HH;
  else;
    if S32 lt 0x8000;
      set val GAP %S32;
      calc sub GAP 1;
      calc add S32 %HH;
      set val NEW 1;
      # words entering the duplicate window: (old >> 6) + 2 .. (new >> 6) + 1
      set val T %S32;
      calc rsh T 6;
      set val HP %HH;
      calc rsh HP 6;
      calc sub T %HP;
      if T ge $DUP_WORDS;
EOF
dup_clear "        "
cat <<EOF
      else;
        if T gt 0;
          decl K 8;
          start-loop;
            calc add HP 1;
            set val K %HP;
            calc add K 1;
            calc and K $((DUP_WORDS - 1));
            set map $DUP %K 0;
            calc sub T 1;
          loop T;
          free K;
        end-if;
      end-if;
    else;
      set val T 0x10000;
      calc sub T %S32;
      set val S32 %HH;
      calc sub S32 %T;
      # backwards and the peer says its sequence restarted: start over.
      # Only new data counts: a retransmission is a stored copy and keeps
      # the flag of the original, so on a long link it arrives far behind.
      if TY eq 1;
        set val HP %FL;
        calc and HP 0x01;
        if HP ne 0;
          # also when it goes below where this receiver started: the
          # packets before it came from the peer's previous instance
          get map $RX 58 HP;
          if S32 lt %HP;
            set val T 64;
          end-if;
          if T ge 64;
            set val S32 %S;
            set val NEW 2;
          end-if;
        end-if;
      end-if;
    end-if;
  end-if;
end-if;
# a jump of more than 16384 is a restart too, not loss
if GAP gt 16384;
  set val NEW 2;
end-if;
if NEW eq 2;
  set val GAP 0;
  set val NEW 1;
  calc-map add $RX 36 1;
  set map $RX 58 %S32;
EOF
dup_clear "  "
cat <<EOF
end-if;
free HP;
if NEW eq 1;
  set val T %S32;
  calc add T 1;
  set map $RX 1 %T;
end-if;

# Duplicate check: test-and-set the bit for this seq.
decl CHK 8;
set val CHK 1;
if NEW eq 0;
  set val T %HH;
  calc sub T %S32;
  if T ge $DUP_OLD;
    set val CHK 0;
    calc-map add $RX 31 1;
  end-if;
end-if;
if CHK eq 1;
  set val CHK %S32;
  calc rsh CHK 6;
  calc and CHK $((DUP_WORDS - 1));
  set val T %S32;
  calc and T 63;
  decl B 8;
  set val B 1;
  calc lsh B %T;
  calc-map or $DUP %CHK %B OLD;
  calc and OLD %B;
  if OLD ne 0;
    if TY eq 3;
      calc-map add $RX 38 1;
    else;
      calc-map add $RX 3 1;
    end-if;
    drop;
  end-if;
  free OLD;
  free B;
end-if;
free CHK;
if NEW eq 0;
  if TY eq 1;
    calc-map add $RX 4 1;
  else;
    calc-map add $RX 7 1;
  end-if;
else;
  if TY eq 3;
    calc-map add $RX 7 1;
  end-if;
end-if;
free S32;
free NEW;
if GAP gt 0;
  calc-map add $RX 5 %GAP;
end-if;
if TY eq 1;
  calc-map add $RX 2 1;
end-if;

decl MS 8;
set val MS %NOW;
calc div MS 1000000;
if TY eq 1;
  # Transit = arrival - sender timestamp (4 us units, mod 2^24). The clocks
  # are not synchronised; only differences of transit times are used.
  decl TR 8;
  set val TR %NOW;
  calc div TR 4000;
  set val T %W;
  calc and T 0xFFFFFF;
  calc sub TR %T;
  calc and TR 0xFFFFFF;
  # Jitter (RFC 3550): J += (|D| - J) / 16, kept as 16 * J in 4 us units.
  get map $RX 12 LT;
  if LT ne 0;
    calc sub LT 1;
    set val T %TR;
    calc sub T %LT;
    calc and T 0xFFFFFF;
    if T ge 0x800000;
      set val LT 0x1000000;
      calc sub LT %T;
      set val T %LT;
    end-if;
    get map $RX 11 J;
    set val LT %J;
    calc div LT 16;
    calc sub J %LT;
    calc add J %T;
    set map $RX 11 %J;
    free J;
  end-if;
  free LT;
  set val T %TR;
  calc add T 1;
  set map $RX 12 %T;
  # Relative one-way delay: transit minus the smallest transit seen in this
  # and the previous 30 s window, i.e. the queueing delay on top of the base.
  get map $RX 15 WS;
  get map $RX 13 MC;
  set val T %MS;
  calc sub T %WS;
  if T ge 30000;
    set map $RX 14 %MC;
    set map $RX 15 %MS;
    set val MC 0;
  end-if;
  free WS;
  if MC eq 0;
    set val MC %TR;
    calc add MC 1;
  else;
    set val T %TR;
    calc add T 1;
    calc sub T %MC;
    calc and T 0xFFFFFF;
    if T ge 0x800000;
      set val MC %TR;
      calc add MC 1;
    end-if;
  end-if;
  set map $RX 13 %MC;
  calc sub MC 1;
  get map $RX 14 MP;
  if MP ne 0;
    calc sub MP 1;
    set val T %MP;
    calc sub T %MC;
    calc and T 0xFFFFFF;
    if T ge 0x800000;
      set val MC %MP;
    end-if;
  end-if;
  free MP;
  set val T %TR;
  calc sub T %MC;
  calc and T 0xFFFFFF;
  if T ge 0x800000;
    set val T 0;
  end-if;
  calc mul T 4;
  free MC;
  free TR;
  get map $RX 16 OW;
  calc mul OW 7;
  calc add OW %T;
  calc div OW 8;
  set map $RX 16 %OW;
  free OW;
  # timestamp to echo in the next report (RTT), 1 << 24 marks it valid
  set val T %W;
  calc and T 0xFFFFFF;
  calc or T 0x1000000;
  set map $RX 21 %T;
  set map $RX 22 %NOW;
  # the peer's FEC state for this direction (its K, 0 = off)
  set val T %FL;
  calc and T 0x02;
  if T ne 0;
    set val T %W;
    calc rsh T 52;
    calc and T 0xF;
  end-if;
  set map $RX 30 %T;
  set map $RX 32 %MS;

end-if;
free FL;

# Control frame due? 1 = NAK for the gap just seen, 2 = report.
decl CT 8;
if GAP gt 0;
  set val CT 1;
else;
  get map $RX 23 RL;
  set val T %MS;
  calc sub T %RL;
  free RL;
  get map $CFG 10 RI;
  if RI eq 0;
    set val RI $REPORT_MS;
  end-if;
  if T ge %RI;
    set val CT 2;
  end-if;
  free RI;
end-if;

# Hand over to the next program: cb[0] = 0xDA7A0000 | control frame due,
# cb[1] = gap size, cb[2] = first missing seq.
set val T 0xDA7A;
calc lsh T 16;
calc or T %CT;
set skb-cb 0 %T;
set skb-cb 1 %GAP;
calc add HH 1;
calc and HH 0xFFFF;
set skb-cb 2 %HH;
continue;
EOF
} | emit ingress $P_DATA "receiver"

########################################################################
# Ingress, fourth: packets accepted by the receiver program. Fold FEC block
# members into their slot, decapsulate and deliver; send NAKs and reports.
########################################################################
{
cat <<EOF
$HEADER
shared-buffer-map $FRX $FEC_SLOTS 1504;
array-map $FSL $((FEC_SLOTS * 4));
match eth-proto 0x88B5;
get skb-cb 0 C0;
decl CT 8;
set val CT %C0;
calc rsh C0 16;
if C0 ne 0xDA7A;
  drop;
end-if;
calc and CT 0xFF;
get skb-cb 1 G4;
decl GAP 8;
set val GAP %G4;
get skb-cb 2 H4;
decl HH 8;
set val HH %H4;
set skb-cb 0 0;
free H4;
free G4;
free C0;
get bytes 14 8 W;
decl TY 8;
set val TY %W;
calc rsh TY 61;
decl S 8;
set val S %W;
calc rsh S 32;
calc and S 0xFFFF;
decl T 8;
if TY eq 1;
  set val T %W;
  calc rsh T 56;
  calc and T 0x10;
  if T ne 0;
    # FEC: fold block members, as received, into the slot for their block.
    decl SL 8;
    set val SL %W;
    calc rsh SL 24;
    calc and SL 0xFF;
    decl KB 8;
    set val KB %SL;
    calc and KB $((FEC_SLOTS - 1));
    set val T %KB;
    calc mul KB 4;
    get map $FSL %KB TAG;
    calc add SL 1;
    if TAG ne %SL;
      zero-buffer-keyed $FRX %T 1504 0;
      set map $FSL %KB %SL;
      calc add KB 1;
      set map $FSL %KB 0;
      calc add KB 1;
      set map $FSL %KB 0;
      calc sub KB 2;
    end-if;
    free TAG;
    free SL;
    free KB;
    # Fold in the packet's true TCP/UDP checksum, as the sender did: virtual
    # NICs (veth, virtio) can deliver packets whose checksum field still holds
    # the unfinished value.
$(fec_norm_code)
    get bytes 24 2 IPL;
    get bytes 28 2 FR;
    calc and FR 0x3FFF;
    get bytes 31 1 PR;
    decl DONE 8;
    if FR eq 0;
      if PR eq 6;
        get bytes 58 2 CS;
        calc-csum tcp TV 22 1500;
        calc hton TV 16;
        set bytes 58 2 %TV;
        xor-packet-keyed $FRX %T %IPL 22 0;
        calc hton CS 16;
        set bytes 58 2 %CS;
        set val DONE 1;
      end-if;
      if PR eq 17;
        get bytes 48 2 CS;
        if CS ne 0;
          calc-csum udp TV 22 1500;
          calc hton TV 16;
          set bytes 48 2 %TV;
          xor-packet-keyed $FRX %T %IPL 22 0;
          calc hton CS 16;
          set bytes 48 2 %CS;
          set val DONE 1;
        end-if;
      end-if;
    end-if;
    if DONE eq 0;
      xor-packet-keyed $FRX %T %IPL 22 0;
    end-if;
    free DONE;
$(fec_restore_code)
    free TV;
    free CS;
    free PR;
    free FR;
    free IPL;
    calc mul T 4;
    calc add T 1;
    calc-map add $FSL %T 1;
    calc add T 1;
    calc-map xor $FSL %T %S;
  end-if;
end-if;

# Decapsulate. Retransmitted packets may carry a partial checksum (they were
# stored before the sender's NIC filled it in): recompute it.
strip-l2 8 0x0800;
if TY eq 3;
  get bytes 20 2 FR;
  calc and FR 0x3FFF;
  if FR eq 0;
    get bytes 23 1 PR;
    if PR eq 6;
      recalc-tcp-csum 14 1500;
    end-if;
    if PR eq 17;
      recalc-udp-csum 14 1500;
    end-if;
    free PR;
  end-if;
  free FR;
end-if;
if CT eq 0;
  accept;
end-if;

# Deliver a copy, and turn this packet into the control frame for the peer.
get skb-ifindex IFX;
clone %IFX ingress;
get dst-mac DM;
get src-mac SM;
set dst-mac %SM;
set src-mac %DM;
set map $RX 33 %SM;
free DM;
free SM;
set eth-proto 0x88B5;
if CT eq 1;
  set len 60;
  if GAP gt $NAK_MAX;
    set val GAP $NAK_MAX;
  end-if;
  set val W 4;
  calc lsh W 61;
  calc lsh GAP 48;
  calc or W %GAP;
  calc lsh HH 32;
  calc or W %HH;
  calc hton W 64;
  set bytes 14 8 %W;
  calc-map add $RX 10 1;
  redirect %IFX egress;
end-if;

# Report: 11 values of 8 bytes after the header.
get time NOW;
decl MS 8;
set val MS %NOW;
calc div MS 1000000;
set len 110;
set map $RX 23 %MS;
calc-map add $RX 29 1;
set val W 5;
calc lsh W 61;
calc hton W 64;
set bytes 14 8 %W;
get map $RX 2 V;
calc hton V 64;
set bytes 22 8 %V;
# raw loss = gaps - late arrivals; residual = raw - FEC - ARQ recoveries
get map $RX 5 G;
get map $RX 4 RO;
decl RAW 8;
if G ge %RO;
  set val RAW %G;
  calc sub RAW %RO;
end-if;
set val V %RO;
set val T %G;
calc hton T 64;
set bytes 94 8 %T;
get map $RX 3 G;
calc lsh G 32;
calc or V %G;
calc hton V 64;
set bytes 70 8 %V;
get map $RX 6 G;
get map $RX 7 RO;
decl RES 8;
set val RES %RAW;
if RES ge %G;
  calc sub RES %G;
else;
  set val RES 0;
end-if;
if RES ge %RO;
  calc sub RES %RO;
else;
  set val RES 0;
end-if;
calc lsh G 32;
calc or G %RO;
calc hton G 64;
set bytes 78 8 %G;
set val T %RES;
calc hton T 64;
set bytes 86 8 %T;
# this window: packets expected (seq advance), raw and residual loss
get map $RX 1 G;
get map $RX 24 RO;
set map $RX 24 %G;
# The peer's sequence restarted (1 starts over from its new number): the
# window is empty. G - RO used to wrap to an enormous window with almost no
# loss, which replaced both loss averages (here and at the peer) with ~0;
# they then took minutes to climb back.
if G lt %RO;
  set val RO %G;
end-if;
calc sub G %RO;
set map $RX 35 %G;
set val T %G;
calc hton T 64;
set bytes 102 8 %T;
get map $RX 25 RO;
set map $RX 25 %RAW;
if RAW ge %RO;
  calc sub RAW %RO;
else;
  set val RAW 0;
end-if;
get map $RX 26 RO;
set map $RX 26 %RES;
if RES ge %RO;
  calc sub RES %RO;
else;
  set val RES 0;
end-if;
free RO;
if G gt 0;
  calc mul RAW 10000;
  calc div RAW %G;
  calc mul RES 10000;
  calc div RES %G;
else;
  set val RAW 0;
  set val RES 0;
end-if;
set map $RX 27 %RAW;
set map $RX 28 %RES;
calc lsh RES 32;
calc or RES %RAW;
calc hton RES 64;
set bytes 30 8 %RES;
# The same averaged estimate the sender keeps, for the inbound direction:
# 39 / 40 = loss / residual in 1/100 bp, 41 = packets averaged.
if G gt 0;
  get map $RX 41 RAW;
  get map $CFG 17 T;
  if T eq 0;
    set val T $LOSS_SMOOTH;
  end-if;
  if RAW gt %T;
    set val RAW %T;
  end-if;
  get map $RX 39 RES;
  calc mul RES %RAW;
  get map $RX 27 T;
  calc mul T 100;
  calc mul T %G;
  calc add RES %T;
  set val T %RAW;
  calc add T %G;
  calc div RES %T;
  set map $RX 39 %RES;
  get map $RX 40 RES;
  calc mul RES %RAW;
  get map $RX 28 T;
  calc mul T 100;
  calc mul T %G;
  calc add RES %T;
  set val T %RAW;
  calc add T %G;
  calc div RES %T;
  set map $RX 40 %RES;
  # 49 = last time the inbound loss left after repair was 1 % or more
  if RES ge 10000;
    set map $RX 49 %MS;
  end-if;
  calc add RAW %G;
  get map $CFG 17 T;
  if T eq 0;
    set val T $LOSS_SMOOTH;
  end-if;
  if RAW gt %T;
    set val RAW %T;
  end-if;
  set map $RX 41 %RAW;
end-if;
free RES;
free RAW;
free G;
# jitter in us (16 * J, 4 us units), relative one-way delay in us
get map $RX 11 V;
calc div V 4;
calc hton V 64;
set bytes 38 8 %V;
get map $RX 16 V;
calc hton V 64;
set bytes 46 8 %V;
# echo: valid:1 | ts:24 << 32 | time held in us
get map $RX 21 V;
if V ne 0;
  get map $RX 22 T2;
  set val T %NOW;
  calc sub T %T2;
  free T2;
  calc div T 1000;
  calc lsh T 32;
  calc rsh T 32;
  calc and V 0xFFFFFF;
  calc lsh V 32;
  calc or V %T;
  set val T 1;
  calc lsh T 63;
  calc or V %T;
end-if;
calc hton V 64;
set bytes 54 8 %V;
# Capacity estimate (19) from the four largest probe samples (53-56): the
# 4th largest of the last 16 is about the 80th percentile. 57 counts the
# samples (within capacity-window, if one is set). With fewer
# samples take the same share from the top: the largest of up to 4, the
# 2nd of up to 8, the 3rd of up to 12. (The 4th was taken from the start,
# which with 5 samples is the 2nd smallest and with fewer than 4 the
# smallest, so a few stretched pairs at start-up set an estimate far too
# low: 1.3 Mbit/s on a 10 Mbit/s link.)
get map $RX 57 T;
get map $RX 56 V;
if T le 12;
  get map $RX 55 V;
end-if;
if T le 8;
  get map $RX 54 V;
end-if;
if T le 4;
  get map $RX 53 V;
end-if;
if V eq 0;
  get map $RX 55 V;
end-if;
if V eq 0;
  get map $RX 54 V;
end-if;
if V eq 0;
  get map $RX 53 V;
end-if;
$(cap_percentile_code)
set map $RX 19 %V;
calc hton V 64;
set bytes 62 8 %V;
redirect %IFX egress;
EOF
} | emit ingress $P_DELIVER "deliver"

########################################################################
# UDP carriers: the last egress program wraps every dataplane frame
# (Ethernet | shim | ...) in UDP, the first ingress program unwraps it, so
# the programs above see the same frames as with the Ethernet carrier.
# Both keep skb->protocol IPv4 (insert-l2 / remove-l2), so a frame can be
# wrapped again after it was cloned or redirected (NAKs, retransmissions).
########################################################################
P_CARRIER_OUT=$((PRIO + 40))
P_CARRIER_IN=$((PRIO - 10))

# udp_addr_code: PI, PP, LI = peer address, peer port, our address
udp_addr_code() {
cat <<EOC
get map $CFG 19 PI;
if PI eq 0;
  get map $TX 60 PI;
end-if;
if PI eq 0;
  set val PI $PEER_IP;
end-if;
get map $CFG 20 PP;
if PP eq 0;
  get map $TX 61 PP;
end-if;
if PP eq 0;
  set val PP $PEER_PORT;
end-if;
get map $CFG 21 LI;
if LI eq 0;
  get map $TX 62 LI;
end-if;
if LI eq 0;
  set val LI $LOCAL_IP;
end-if;
EOC
}

# udp_in_check_code: the first checks of a received frame: IPv4 without
# options, not a fragment, UDP to our port, at least <min> bytes long.
udp_in_check_code() {
cat <<EOC
match eth-proto 0x0800;
get bytes 14 1 VH;
if VH ne 0x45;
  continue;
end-if;
free VH;
get bytes 23 1 PR;
if PR ne 17;
  continue;
end-if;
free PR;
get bytes 36 2 DP;
if DP ne $UDP_PORT;
  continue;
end-if;
free DP;
get bytes 20 2 FR;
calc and FR 0x3FFF;
if FR ne 0;
  continue;
end-if;
free FR;
get len FL;
if FL lt $1;
  continue;
end-if;
free FL;
EOC
}

if [ "$CARRIER" = udp ]; then
{
cat <<EOF
$HEADER
#
# Carrier udp, sending: Ethernet | IPv4 (us -> peer, DF, TTL 64, the DSCP of
# the packet carried) | UDP ($UDP_PORT -> the peer's port, no checksum) |
# shim | ... ; the Ethernet header from a route lookup of the peer.
match eth-proto 0x88B5;
get bytes 14 1 TB;
decl TY 8;
set val TY %TB;
free TB;
calc rsh TY 5;
# a keepalive is a clone of some packet: 60 bytes are enough
if TY eq 6;
  set len 60;
end-if;
get len FL;
decl L 8;
set val L %FL;
calc add L 14;
free FL;
get bytes 23 1 IT;
decl TOS 8;
if TY eq 1;
  set val TOS %IT;
end-if;
if TY eq 3;
  set val TOS %IT;
end-if;
free IT;
calc and TOS 0xFC;
$(udp_addr_code)
decl Z 8;
set val Z %PI;
calc mul Z %LI;
if Z eq 0;
  # (a keepalive before the peer is known is not counted)
  if TY ne 6;
    calc-map add $TX 65 1;
  end-if;
  drop;
end-if;
free Z;
get time KN;
calc div KN 1000000;
set map $TX 67 %KN;
free KN;
insert-l2 28 0x0800;
decl CS 8;
decl CT 8;
decl W 8;
set val W 0x45;
calc lsh W 8;
calc or W %TOS;
calc lsh W 16;
calc or W %L;
calc lsh W 32;
calc or W 0x4000;
$(csum_add W 64)
decl W2 8;
set val W2 0x4011;
calc lsh W2 48;
calc or W2 %LI;
$(csum_add W2 64)
$(csum_add PI 32)
$(csum_fold)
set val CT %CS;
calc lsh CT 32;
calc or W2 %CT;
decl W3 8;
set val W3 %PI;
calc lsh W3 16;
calc or W3 $UDP_PORT;
calc lsh W3 16;
calc or W3 %PP;
decl U 4;
set val CT %L;
calc sub CT 20;
calc lsh CT 16;
set val U %CT;
calc hton W 64;
calc hton W2 64;
calc hton W3 64;
calc hton U 32;
set bytes 14 8 %W;
set bytes 22 8 %W2;
set bytes 30 8 %W3;
set bytes 38 4 %U;
fib-lookup output;
if FIB_RESULT eq 0;
  set dst-mac %FIB_DMAC;
  set src-mac %FIB_SMAC;
end-if;
continue;
EOF
} | emit egress $P_CARRIER_OUT "carrier"

{
cat <<EOF
$HEADER
#
# Carrier udp, receiving: a UDP packet to port $UDP_PORT from the peer loses
# its outer IPv4 + UDP header (28 bytes) and goes on as a dataplane frame.
$(udp_in_check_code 50)
get bytes 26 4 SA;
decl SAV 8;
set val SAV %SA;
free SA;
get bytes 42 1 TB;
decl TY 8;
set val TY %TB;
free TB;
calc rsh TY 5;
if TY eq 0;
  calc-map add $RX 94 1;
  drop;
end-if;
if TY gt 6;
  calc-map add $RX 94 1;
  drop;
end-if;
EOF
if [ $PEER_LEARN -eq 0 ]; then
cat <<EOF
# from the peer only
get map $CFG 19 PI;
if PI eq 0;
  set val PI $PEER_IP;
end-if;
if SAV ne %PI;
  calc-map add $RX 94 1;
  drop;
end-if;
free PI;
EOF
else
cat <<EOF
# peer = learn: from ${VAL[peer-learn-from]}; its address and port are
# where this end sends (the latest, so a NAT that moves it is followed)
decl T 8;
decl M 8;
set val T %SAV;
set val M $LEARN_MASK;
calc and T %M;
set val M $LEARN_NET;
if T ne %M;
  calc-map add $RX 94 1;
  drop;
end-if;
free M;
free T;
get bytes 34 2 SP;
decl SPV 8;
set val SPV %SP;
free SP;
get map $TX 60 OP;
get map $TX 61 OQ;
decl CH 8;
if OP ne %SAV;
  set val CH 1;
end-if;
if OQ ne %SPV;
  set val CH 1;
end-if;
if CH eq 1;
  set map $TX 60 %SAV;
  set map $TX 61 %SPV;
  calc-map add $TX 66 1;
end-if;
EOF
fi
if [ $LOCAL_AUTO -eq 1 ]; then
cat <<EOF
# local-address auto: the address the peer sends to (behind NAT, the one
# this interface has) is the source from now on
get bytes 30 4 DA;
decl DAV 8;
set val DAV %DA;
free DA;
get map $TX 62 OL;
if OL ne %DAV;
  set map $TX 62 %DAV;
end-if;
EOF
fi
cat <<EOF
calc-map add $RX 93 1;
remove-l2 28 0x88B5;
continue;
EOF
} | emit ingress $P_CARRIER_IN "carrier"
fi

if [ "$CARRIER" = udp-inline ]; then
{
cat <<EOF
$HEADER
#
# Carrier udp-inline, sending. A frame that carries an IP packet (data,
# retransmission) keeps its IP header as the outer one, as it is (addresses,
# TOS, TTL, ID), with protocol UDP:
#   Ethernet | IP | UDP (0xB500 + the protocol -> $UDP_PORT) | shim | L4 ...
# 16 bytes. Other frames (parity, NAK, report) get an IP header of the
# traffic they belong to (36 bytes): parity the addresses of the last packet
# sent and the TOS and TTL of the packet it was made from, NAKs and reports
# those of the last packet received, swapped.
match eth-proto 0x88B5;
get bytes 14 8 SW;
decl TY 8;
set val TY %SW;
calc rsh TY 61;
decl D 8;
if TY eq 1;
  set val D 1;
end-if;
if TY eq 3;
  set val D 1;
end-if;
get len FL;
decl H0 8;
decl H2 8;
decl SD 8;
decl SP 8;
decl L 8;
decl T 8;
set val SP 0xB5;
calc lsh SP 8;
if D eq 1;
  get bytes 22 8 HA;
  get bytes 30 4 HB;
  get bytes 34 8 HC;
  set map $TX 64 %HC;
  set val SD %HC;
  set val H0 %HA;
  set val T 16;
  calc lsh T 32;
  calc add H0 %T;
  set val L %HA;
  calc rsh L 32;
  calc and L 0xFFFF;
  calc add L 16;
  # the protocol goes in the source port
  set val T %HB;
  calc rsh T 16;
  calc and T 0xFF;
  calc or SP %T;
  set val H2 %HB;
  calc rsh H2 24;
  calc lsh H2 8;
  calc or H2 17;
  free HC;
  free HB;
  free HA;
else;
  if TY eq 2;
    get map $TX 64 SD;
  else;
    get map $RX 92 RV;
    set val SD %RV;
    calc lsh SD 32;
    set val T %RV;
    calc rsh T 32;
    calc or SD %T;
    free RV;
  end-if;
  if SD eq 0;
    drop;
  end-if;
  # TOS and TTL: of the packet a parity frame was made from, else 0 and 64
  get skb-cb 3 QC;
  decl QV 8;
  set val QV %QC;
  free QC;
  set val T %QV;
  calc rsh T 16;
  if T ne 0xB5A1;
    set val QV 64;
    calc lsh QV 8;
  end-if;
  set skb-cb 3 0;
  set val L %FL;
  calc add L 14;
  set val H0 0x45;
  calc lsh H0 8;
  set val T %QV;
  calc and T 0xFF;
  calc or H0 %T;
  calc lsh H0 16;
  calc or H0 %L;
  calc lsh H0 32;
  calc or H0 0x4000;
  set val H2 %QV;
  calc rsh H2 8;
  calc and H2 0xFF;
  calc lsh H2 8;
  calc or H2 17;
  free QV;
end-if;
free FL;
if D eq 1;
  insert-l2 8 0x0800;
else;
  insert-l2 28 0x0800;
end-if;
decl CS 8;
decl CT 8;
$(csum_add H0 64)
$(csum_add H2 16)
$(csum_add SD 64)
$(csum_fold)
# 22: TTL, UDP, checksum, source; 30: destination, ports; 38: UDP length
calc lsh H2 16;
calc or H2 %CS;
calc lsh H2 32;
set val T %SD;
calc rsh T 32;
calc or H2 %T;
calc lsh SD 32;
set val T %SP;
calc lsh T 16;
calc or T $UDP_PORT;
calc or SD %T;
decl U 4;
set val T %L;
calc sub T 20;
calc lsh T 16;
set val U %T;
calc hton H0 64;
calc hton H2 64;
calc hton SD 64;
calc hton U 32;
set bytes 14 8 %H0;
set bytes 22 8 %H2;
set bytes 30 8 %SD;
set bytes 38 4 %U;
if D eq 1;
  # the shim moved with the 8 inserted bytes: put it after the UDP header
  calc hton SW 64;
  set bytes 42 8 %SW;
end-if;
continue;
EOF
} | emit egress $P_CARRIER_OUT "carrier"

{
cat <<EOF
$HEADER
#
# Carrier udp-inline, receiving: UDP from a source port 0xB5xx to port
# $UDP_PORT becomes a dataplane frame again. A data packet gets its IP header
# back as it arrived (TOS and TTL as the path left them), with the protocol
# from the source port; other frames lose the 28 bytes, and a parity frame
# hands its TOS and TTL on in skb->cb 3 (for the packet it rebuilds).
$(udp_in_check_code 50)
get bytes 34 2 SPB;
decl SP 8;
set val SP %SPB;
free SPB;
decl T 8;
set val T %SP;
calc rsh T 8;
if T ne 0xB5;
  continue;
end-if;
get bytes 42 8 SW;
decl TY 8;
set val TY %SW;
calc rsh TY 61;
if TY eq 0;
  calc-map add $RX 94 1;
  drop;
end-if;
if TY gt 5;
  calc-map add $RX 94 1;
  drop;
end-if;
calc-map add $RX 93 1;
decl D 8;
if TY eq 1;
  set val D 1;
end-if;
if TY eq 3;
  set val D 1;
end-if;
if D eq 1;
  get bytes 14 8 H0;
  get bytes 22 4 HB;
  decl H2 8;
  set val H2 %HB;
  free HB;
  get bytes 26 8 SD;
  set map $RX 92 %SD;
  # length - 16; protocol from the source port
  set val T 16;
  calc lsh T 32;
  calc sub H0 %T;
  calc rsh H2 24;
  calc lsh H2 8;
  calc and SP 0xFF;
  calc or H2 %SP;
  decl CS 8;
  decl CT 8;
$(csum_add H0 64)
$(csum_add H2 16)
$(csum_add SD 64)
$(csum_fold)
  calc lsh H2 16;
  calc or H2 %CS;
  calc lsh H2 32;
  set val T %SD;
  calc rsh T 32;
  calc or H2 %T;
  decl D4 4;
  set val D4 %SD;
  calc hton H0 64;
  calc hton H2 64;
  calc hton D4 32;
  calc hton SW 64;
  # shim at 22, IP header at 30: after removing 8 bytes, 14 and 22
  set bytes 22 8 %SW;
  set bytes 30 8 %H0;
  set bytes 38 8 %H2;
  set bytes 46 4 %D4;
  remove-l2 8 0x88B5;
  continue;
end-if;
if TY eq 2;
  get bytes 15 1 QT;
  get bytes 22 1 QL;
  set val T 0xB5A1;
  calc lsh T 8;
  calc or T %QL;
  calc lsh T 8;
  calc or T %QT;
  set skb-cb 3 %T;
end-if;
remove-l2 28 0x88B5;
continue;
EOF
} | emit ingress $P_CARRIER_IN "carrier"
fi

#!/bin/bash
# bpfc-dataplane-gen - generate the FEC / INT / ARQ / probing dataplane for
# one interface as bpfc programs for /etc/bpfc/interfaces.d.
#
# Every interface gets its own maps (named <prefix>_tx, _rx, ...), so several
# interfaces run independently. The default prefix is "dp" + 8 base32
# characters of the interface name's SHA-256: any valid interface name gives
# a map name the kernel accepts in full (15 characters at most). Both ends of a point-to-point link run the
# same programs; each end is the sender for its own direction.
#
# Settings come from built-in defaults, then a profile (--profile, which may
# inherit from others), then the command line. --link-rate and --rtt size the
# retransmit ring, the duplicate window and the FEC receive slots.
#
# See DESIGN.md for the wire format and how the pieces fit together.

set -e
VERSION=3
SELF_DIR=$(cd "$(dirname "$0")" && pwd)
PROFILE_DIRS=(/etc/bpfc/dataplane/profiles.d /usr/share/bpfc/dataplane/profiles "$SELF_DIR/profiles")
SAVE_DIR=/etc/bpfc/dataplane/profiles.d
NAK_MAX=32          # sequences one NAK can ask for

die()  { echo "Error: $*" >&2; exit 1; }
warn() { [ -n "$SHOW" ] || echo "Warning: $*" >&2; WARNINGS+=("$*"); }
WARNINGS=()

# ---------------------------------------------------------------- settings
# key | kind | class | default | help
#   kind:  rate, dur:<default unit>, int:<min>:<max>, auto-int:<min>:<max>,
#          pct, enum:<a>,<b>..., arqfec, prate (per second, decimals allowed),
#          peer (IPv4[:port] or learn), prefix, prefixes (comma list),
#          ipv4-auto (IPv4 or auto)
#   class: sizing / structural (needs regenerating), runtime (also changeable
#          with "bpfc-dataplane-status set")
SETTINGS='link-rate|rate|sizing||link rate, e.g. 20m, 1g (sizes the buffers below)
rtt|dur:ms|sizing||round-trip time, e.g. 30ms, 800ms (sizes the buffers below)
sizing-packet-bytes|int:64:9000|sizing|1000|average packet size assumed when sizing
arq-depth|auto-int:1:16384|structural|auto|packets kept for retransmission (auto: rate x RTT x 1.5, else 10)
arq-with-fec|arqfec|runtime|3|ARQ while FEC is on: keep, off, N packets or a time like 200ms
dup-window|auto-int:1024:16384|structural|auto|duplicate window in packets (auto: rate x (2 RTT + 100 ms), else 1024)
fec-slots|auto-int:16:64|structural|auto|FEC blocks the receiver tracks at once (auto: 4 per CPU, 16-64)
fec-threshold|pct|runtime|1|loss that turns FEC on, percent
fec-cooldown|dur:s|runtime|10s|loss must stay below the threshold this long before FEC turns off
fec-k|int:1:15|runtime|8|parity ratio 1:N when the link looks congested, or with fec-mode on
fec-k-min|int:1:15|runtime|2|smallest N when scaling with loss
fec-k-max|int:1:15|runtime|15|largest N when scaling with loss
fec-floor|int:0:15|runtime|0|in auto mode never less than 1 parity per N packets (0: FEC turns off)
fec-timeout|dur:ms|runtime|50ms|send parity for a partly filled block after this long
fec-mode|enum:auto,on,off|runtime|auto|auto, on or off
report-interval|dur:ms|runtime|1000ms|report interval (each report covers the packets since the last)
loss-smoothing|int:100:1000000|runtime|2000|packets the loss estimate averages over (packet-weighted)
probe-interval|dur:s|runtime|10s|packet-pair probe interval (10 ms - 1 day)
probe-rate|prate|runtime||packet-pair probes per second, e.g. 0.1, 2, 20 (sets the interval; overrides probe-interval)
probe-backoff|int:1:1000|runtime|6|multiply the probe interval by N while FEC is on
probe-min-bytes|int:64:1500|runtime|600|only probe with packets of at least N bytes
probe-train|dur:ms|runtime|0|probe with a train instead of a pair: as many copies as cross the link in this long at the measured rate, e.g. 20ms for links that deliver in frames (Starlink, cellular, DOCSIS), where pairs read far too fast (0: pairs)
probe-train-max|int:3:256|runtime|64|most packets in a probe train
probe-train-skip|int:0:50|runtime|10|percent of the first packets of a train left out of the timing (the first frame, the grant of a scheduler)
capacity-percentile|int:0:100|runtime|0|capacity = this percentile of the samples (50: the median, for trains); 0: the rule for pairs (about the 80th, the highest share while samples are few)
capacity-window|dur:s|runtime|0|capacity from probe samples of the last N only, e.g. 15s for a LEO terminal that changes satellite every 15 s (0: the last 16 samples, however old)
congestion-pct|int:1:100|runtime|85|utilisation above which loss counts as congestion (FEC not scaled up)
congestion-delay|dur:ms|runtime|20ms|queueing delay above which loss counts as congestion
carrier|enum:ethernet,udp,udp-inline|structural|ethernet|how frames cross the link: ethernet (one Layer-2 segment), udp (outer IPv4/UDP to the peer: routed paths, the internet, NAT), udp-inline (UDP after the original IP header, addresses and TOS kept for QoS on the path: a private routed WAN)
udp-port|int:1:65535|structural|47810|UDP carriers: the port this end sends from and receives on
protect|prefixes|structural||UDP carriers: remote prefixes carried to the peer, e.g. 10.2.0.0/16,10.3.0.0/16 (0.0.0.0/0 for all); other traffic is left alone
peer|peer|runtime||carrier udp: the peer, IPv4[:port] (port default udp-port), or learn: from its packets (the end facing a peer behind NAT)
peer-learn-from|prefix|structural|0.0.0.0/0|carrier udp, peer = learn: only learn a peer whose address is in this prefix
local-address|ipv4-auto|runtime|auto|carrier udp: the outer source address (auto: the interface address at generation, then the address the peer sends to)
keepalive|dur:s|runtime|25s|carrier udp: send to the peer at least this often, so a NAT mapping stays open; rides on other IPv4 traffic leaving the interface (0: off)
path-mtu|int:576:1500|sizing|1500|largest IP packet the link or path carries; packets that would not fit with the dataplane headers go out unprotected'

declare -A KIND CLASS DEF HELP VAL SRC CLI
KEYS=()
while IFS='|' read -r k kind class def help; do
    KEYS+=("$k"); KIND[$k]=$kind; CLASS[$k]=$class; DEF[$k]=$def; HELP[$k]=$help
done <<< "$SETTINGS"
is_key() { [ -n "${KIND[$1]+x}" ]; }

usage() {
cat <<EOF
Usage: $(basename "$0") -i <interface> [--profile NAME] [settings...]
       $(basename "$0") --list-profiles
       $(basename "$0") --show-profile NAME [settings...]
       $(basename "$0") --save-profile NAME [--profile BASE] [--description TEXT] [settings...] [-i IF]

Writes <outdir>/<interface>/egress/*.bpfc and ingress/*.bpfc.

  -i, --interface IF       interface to generate for
  -o, --outdir DIR         default /etc/bpfc/interfaces.d (use - for stdout)
  -P, --prefix NAME        map name prefix (1-10 of A-Z a-z 0-9 _ .), default
                           dp + 8 characters hashed from the interface name
  -m, --map-dir DIR        pinned maps, for --remove-maps (default /sys/fs/bpf)
      --map-prefix         print the map prefix for -i (and --prefix) and exit
      --remove-maps        delete the interface's pinned maps from --map-dir
                           (also those of generator v2, dp_<interface>_*);
                           remove its programs first
  -b, --priority N         first TC priority, default 100 (uses N..N+30;
                           the UDP carriers also N-10 on ingress, N+40 on egress)
  -p, --profile NAME       start from a profile (see --list-profiles)
      --profile-dir DIR    also look for profiles in DIR (searched first)
      --list-profiles      list the available profiles
      --show-profile NAME  print every effective setting, where it comes from,
                           and the sizes derived from --link-rate / --rtt
      --save-profile NAME  save --profile and the settings given on the
                           command line as a new profile (in $SAVE_DIR,
                           or --profile-dir)
      --description TEXT   description for --save-profile
      --setup-hints        print the ip/ethtool commands for the interface

Settings (--name value or --name=value; the same names are used in profiles):
EOF
    local k
    for k in "${KEYS[@]}"; do
        printf "  --%-22s %s%s\n" "$k" "${HELP[$k]}" "$( [ -n "${DEF[$k]}" ] && echo " [${DEF[$k]}]")"
    done
cat <<EOF
Durations take us, ms, s or m (a bare number is in the unit shown by the
default); rates take k, m or g (bits per second).

With carrier ethernet the interface must carry 1514-byte frames (MTU 1500)
while IP uses 1492: set "mtu lock 1492" on the routes through it. The UDP
carriers need 1464 on the routes to the
protected prefixes. Turn off TSO/GSO/GRO on it and set gso_max_segs 1; see
--setup-hints (with the profile and settings, for the carrier).
EOF
}

# ---------------------------------------------------------------- units

# rate -> bits per second
parse_rate() {
    local v=${1,,}
    v=${v%/s}; v=${v%bps}; v=${v%bit}; v=${v%b}
    [[ "$v" =~ ^([0-9]+(\.[0-9]+)?)([kmg]?)$ ]] || return 1
    awk -v n="${BASH_REMATCH[1]}" -v u="${BASH_REMATCH[3]}" \
        'BEGIN{m = (u=="k")?1e3:(u=="m")?1e6:(u=="g")?1e9:1; printf "%.0f\n", n*m}'
}
# duration <value> <default unit> -> milliseconds (at least 1 if non-zero)
parse_dur() {
    local v=${1,,}
    [[ "$v" =~ ^([0-9]+(\.[0-9]+)?)(us|ms|s|m)?$ ]] || return 1
    local u=${BASH_REMATCH[3]:-$2}
    awk -v n="${BASH_REMATCH[1]}" -v u="$u" \
        'BEGIN{f = (u=="us")?0.001:(u=="ms")?1:(u=="s")?1000:60000; x = n*f; if (x > 0 && x < 1) x = 1; printf "%.0f\n", x}'
}
# IPv4 helpers: ip_ok <a.b.c.d>, ip2int <a.b.c.d>, int2ip <n>, prefix_ok <a.b.c.d/n>
ip_ok() {
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    local i; for i in 1 2 3 4; do [ "${BASH_REMATCH[$i]}" -le 255 ] || return 1; done
}
port_ok() { [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
ip2int() { local IFS=.; set -- $1; echo $(( (10#$1 << 24) | (10#$2 << 16) | (10#$3 << 8) | 10#$4 )); }
int2ip() { echo "$(( ($1 >> 24) & 255 )).$(( ($1 >> 16) & 255 )).$(( ($1 >> 8) & 255 )).$(( $1 & 255 ))"; }
prefix_ok() { [[ "$1" == */* ]] && ip_ok "${1%/*}" && [[ "${1#*/}" =~ ^[0-9]{1,2}$ ]] && [ "${1#*/}" -le 32 ]; }
# prefix_net_mask <a.b.c.d/n>: "net mask" as numbers (net with host bits cleared)
prefix_net_mask() {
    local n=${1#*/} m
    m=$(( n == 0 ? 0 : (0xFFFFFFFF << (32 - n)) & 0xFFFFFFFF ))
    echo "$(( $(ip2int "${1%/*}") & m )) $m"
}
pow2_up() { local n=$1 p=1; while [ $p -lt "$n" ]; do p=$((p * 2)); done; echo $p; }
human_rate() {
    awk -v b="$1" 'BEGIN{ if (b >= 1e9) printf "%.3g Gbit/s", b/1e9; else if (b >= 1e6) printf "%.3g Mbit/s", b/1e6;
                         else if (b >= 1e3) printf "%.3g kbit/s", b/1e3; else printf "%d bit/s", b }'
}

# check_value <key> <value>: exit with a message if invalid
check_value() {
    local k=$1 v=$2 where="$k = $2 (from ${SRC[$1]:-command line})"
    local kind=${KIND[$k]} lo hi
    case "$kind" in
        rate) [ -z "$v" ] || parse_rate "$v" >/dev/null || die "$where: not a rate (e.g. 20m, 1g)" ;;
        dur:*) [ -z "$v" ] || parse_dur "$v" "${kind#dur:}" >/dev/null || die "$where: not a duration (e.g. 50ms, 10s)" ;;
        int:*|auto-int:*)
            IFS=: read -r _ lo hi <<< "$kind"
            [[ "$kind" == auto-int:* && "$v" == auto ]] && return 0
            [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge "$lo" ] && [ "$v" -le "$hi" ] ||
                die "$where: must be $( [[ "$kind" == auto-* ]] && echo "auto or ")$lo-$hi" ;;
        pct) [[ "${v%\%}" =~ ^[0-9]+(\.[0-9]{1,2})?$ ]] || die "$where: must be a percentage like 1 or 0.5" ;;
        enum:*) [[ ",${kind#enum:}," == *",$v,"* ]] || die "$where: must be one of ${kind#enum:}" ;;
        prate) [ -z "$v" ] || { [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v r="$v" 'BEGIN{exit !(r >= 0.00002 && r <= 100)}'; } ||
                die "$where: must be 0.00002-100 probes per second" ;;
        arqfec) [[ "$v" =~ ^(keep|off|[1-9][0-9]*|[0-9]+(\.[0-9]+)?(us|ms|s))$ ]] || die "$where: must be keep, off, a number or a time" ;;
        peer) [ -z "$v" ] || [ "$v" = learn ] || { ip_ok "${v%%:*}" && { [[ "$v" != *:* ]] || port_ok "${v#*:}"; }; } ||
                die "$where: must be an IPv4 address, IPv4:port or learn" ;;
        prefix) prefix_ok "$v" || die "$where: must be a prefix like 198.51.100.0/24" ;;
        prefixes) [ -z "$v" ] || { local x; IFS=, read -ra x <<< "$v"; for v in "${x[@]}"; do prefix_ok "$v" || die "$where: '$v' is not a prefix like 10.2.0.0/16"; done; } ;;
        ipv4-auto) [ "$v" = auto ] || ip_ok "$v" || die "$where: must be an IPv4 address or auto" ;;
    esac
}

# ---------------------------------------------------------------- profiles

find_profile() {    # name -> path of the first match
    local d
    for d in "${PROFILE_DIRS[@]}"; do
        [ -r "$d/$1.profile" ] && { echo "$d/$1.profile"; return 0; }
    done
    return 1
}

declare -A PDESC
PROFILE_CHAIN=()
# load_profile <name> <depth>: parents first, then this profile's settings
load_profile() {
    local name=$1 depth=${2:-0} path n line key val parent=""
    [[ "$name" =~ ^[A-Za-z0-9_.-]{1,40}$ ]] || die "invalid profile name '$name'"
    [ "$depth" -le 8 ] || die "profile inheritance deeper than 8 levels (loop?) at '$name'"
    local p; for p in "${PROFILE_CHAIN[@]}"; do
        if [ "$p" = "$name" ]; then
            local chain; chain=$(printf "%s -> " "${PROFILE_CHAIN[@]}")
            die "profile inheritance loop: $chain$name"
        fi
    done
    path=$(find_profile "$name") || die "profile '$name' not found (looked in ${PROFILE_DIRS[*]})"
    local -a keys=() vals=()
    n=0
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        line=$(sed -e 's/\(^\|[[:space:]]\)#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' <<< "$line")
        [ -z "$line" ] && continue
        [[ "$line" =~ ^([a-z0-9-]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || die "$path:$n: expected 'name = value'"
        key=${BASH_REMATCH[1]}; val=${BASH_REMATCH[2]}
        case "$key" in
            inherit) parent=$val ;;
            description) PDESC[$name]=$val ;;
            *) is_key "$key" || die "$path:$n: unknown setting '$key'"
               keys+=("$key"); vals+=("$val") ;;
        esac
    done < "$path"
    [ -n "$parent" ] && { PROFILE_CHAIN+=("$name"); load_profile "$parent" $((depth + 1)); unset 'PROFILE_CHAIN[-1]'; }
    local i
    for i in "${!keys[@]}"; do VAL[${keys[$i]}]=${vals[$i]}; SRC[${keys[$i]}]="profile $name"; done
    RESOLVED_CHAIN+=("$name")
}
RESOLVED_CHAIN=()

list_profiles() {
    local d f name seen=" "
    printf "%-14s %-52s %s\n" PROFILE DESCRIPTION FILE
    for d in "${PROFILE_DIRS[@]}"; do
        for f in "$d"/*.profile; do
            [ -r "$f" ] || continue
            name=$(basename "$f" .profile)
            local desc
            desc=$(sed -n -e 's/\(^\|[[:space:]]\)#.*$//' -e 's/^[[:space:]]*description[[:space:]]*=[[:space:]]*//p' "$f" | head -1)
            if [[ "$seen" == *" $name "* ]]; then
                printf "%-14s %-52s %s (hidden by the one above)\n" "$name" "${desc:0:52}" "$f"
            else
                printf "%-14s %-52s %s\n" "$name" "${desc:0:52}" "$f"
                seen+="$name "
            fi
        done
    done
}

# ---------------------------------------------------------------- command line

IFACE=""; OUTDIR=/etc/bpfc/interfaces.d; PREFIX=""; PRIO=100; MAP_DIR=/sys/fs/bpf
PRINT_PREFIX=0; REMOVE_MAPS=0
PROFILE=""; SHOW=""; SAVE=""; DESCRIPTION=""; LIST=0; HINTS=0
while [ $# -gt 0 ]; do
    arg=$1; val=""; has_eq=0
    if [[ "$arg" == --*=* ]]; then val=${arg#*=}; arg=${arg%%=*}; has_eq=1; fi
    need() { if [ $has_eq -eq 1 ]; then return; fi; [ $# -ge 2 ] || die "$arg needs a value"; val=$2; SHIFT=1; }
    SHIFT=0
    case "$arg" in
        -i|--interface) need "$@"; IFACE=$val ;;
        -o|--outdir) need "$@"; OUTDIR=$val ;;
        -P|--prefix) need "$@"; PREFIX=$val ;;
        -m|--map-dir) need "$@"; MAP_DIR=$val ;;
        --map-prefix) PRINT_PREFIX=1 ;;
        --remove-maps) REMOVE_MAPS=1 ;;
        -b|--priority) need "$@"; PRIO=$val ;;
        -p|--profile) need "$@"; PROFILE=$val ;;
        --profile-dir) need "$@"; PROFILE_DIRS=("$val" "${PROFILE_DIRS[@]}"); SAVE_DIR=$val ;;
        --list-profiles) LIST=1 ;;
        --show-profile) need "$@"; SHOW=$val ;;
        --save-profile) need "$@"; SAVE=$val ;;
        --description) need "$@"; DESCRIPTION=$val ;;
        --setup-hints) HINTS=1 ;;
        -h|--help) usage; exit 0 ;;
        --*) is_key "${arg#--}" || { echo "Unknown option: $arg" >&2; usage >&2; exit 2; }
             need "$@"; CLI[${arg#--}]=$val ;;
        *) echo "Unknown option: $arg" >&2; usage >&2; exit 2 ;;
    esac
    shift $((1 + SHIFT))
done

if [ $LIST -eq 1 ]; then list_profiles; exit 0; fi

# ---------------------------------------------------------------- names

# Interface names as the kernel accepts them: 1-15 bytes, not "." or "..",
# no "/", ":" or whitespace, no "%" (the kernel takes it as a "%d" name
# template); control characters are refused too.
valid_ifname() {
    local n=$1 len
    len=$(LC_ALL=C; echo ${#n})
    [ "$len" -ge 1 ] && [ "$len" -le 15 ] || return 1
    [ "$n" != . ] && [ "$n" != .. ] || return 1
    [[ "$n" =~ [[:space:][:cntrl:]/:%] ]] && return 1
    return 0
}
# map_id <name>: "dp" + 8 base32 characters (a-z 2-7) of SHA-256(name), 40 bits
map_id() {
    local h n a=abcdefghijklmnopqrstuvwxyz234567 out="" i
    h=$(printf '%s' "$1" | sha256sum); n=$((16#${h:0:10}))
    for i in 1 2 3 4 5 6 7 8; do out=${a:$((n & 31)):1}$out; n=$((n >> 5)); done
    echo "dp$out"
}
# pct_encode <s>: the interface name in comments and key=value lines
pct_encode() {
    local LC_ALL=C s=$1 out="" c i
    for ((i = 0; i < ${#s}; i++)); do
        c=${s:i:1}
        if [[ "$c" =~ ^[A-Za-z0-9_.@+-]$ ]]; then out+=$c; else out+=$(printf '%%%02X' "'$c"); fi
    done
    echo "$out"
}
MAP_SUFFIXES=(tx rx pcpu cfg arq atag ftx frx fsl dup)

if [ -n "$IFACE" ]; then
    valid_ifname "$IFACE" || die "invalid interface name '$IFACE' (1-15 bytes, no '/', ':', '%' or whitespace)"
    [ -n "$PREFIX" ] || PREFIX=$(map_id "$IFACE")
    [[ "$PREFIX" =~ ^[A-Za-z0-9_.]{1,10}$ ]] || die "invalid prefix '$PREFIX' (1-10 of A-Z a-z 0-9 _ .)"
fi
if [ $PRINT_PREFIX -eq 1 ]; then
    [ -n "$IFACE" ] || die "--map-prefix needs -i <interface>"
    echo "$PREFIX"; exit 0
fi
if [ $REMOVE_MAPS -eq 1 ]; then
    [ -n "$IFACE" ] || die "--remove-maps needs -i <interface>"
    removed=0
    for p in "$PREFIX" "dp_$IFACE"; do
        for sfx in "${MAP_SUFFIXES[@]}"; do
            f="$MAP_DIR/${p}_$sfx"
            if [ -e "$f" ]; then rm -f -- "$f" && echo "removed $f" && removed=$((removed + 1)); fi
        done
    done
    [ $removed -gt 0 ] || echo "no maps for $IFACE in $MAP_DIR"
    exit 0
fi

[ $HINTS -eq 0 ] || [ -n "$IFACE" ] || die "--setup-hints needs -i <interface>"

# ---------------------------------------------------------------- resolve

for k in "${KEYS[@]}"; do VAL[$k]=${DEF[$k]}; SRC[$k]=default; done
[ -n "$SHOW" ] && [ -z "$PROFILE" ] && PROFILE=$SHOW
[ -n "$PROFILE" ] && load_profile "$PROFILE"
for k in "${!CLI[@]}"; do VAL[$k]=${CLI[$k]}; SRC[$k]="command line"; done
for k in "${KEYS[@]}"; do check_value "$k" "${VAL[$k]}"; done

RATE_BPS=""; RTT_MS=""
[ -n "${VAL[link-rate]}" ] && RATE_BPS=$(parse_rate "${VAL[link-rate]}")
[ -n "${VAL[rtt]}" ] && RTT_MS=$(parse_dur "${VAL[rtt]}" ms)
[ -n "$RATE_BPS" ] && { [ "$RATE_BPS" -ge 1000 ] || die "link-rate below 1 kbit/s"; }
[ -n "$RTT_MS" ] && { [ "$RTT_MS" -ge 1 ] && [ "$RTT_MS" -le 30000 ] || die "rtt must be 1 ms - 30 s"; }
SIZING=${VAL[sizing-packet-bytes]}
SIZED=0; PPS=0
if [ -n "$RATE_BPS" ] && [ -n "$RTT_MS" ]; then
    SIZED=1
    PPS=$(( RATE_BPS / 8 / SIZING )); [ $PPS -ge 1 ] || PPS=1
elif [ -n "$RATE_BPS$RTT_MS" ]; then
    warn "link-rate and rtt are only used together; buffers keep their default sizes"
fi

ceil_div() { echo $(( ($1 + $2 - 1) / $2 )); }

# ARQ ring: everything sent during one RTT, with 50 % margin
if [ "${VAL[arq-depth]}" = auto ]; then
    if [ $SIZED -eq 1 ]; then
        need=$(ceil_div $((PPS * RTT_MS * 3)) 2000)
        ARQ_DEPTH=$need
        [ $ARQ_DEPTH -ge 10 ] || ARQ_DEPTH=10
        if [ $ARQ_DEPTH -gt 16384 ]; then
            warn "rate x RTT needs an ARQ ring of $need packets; capped at 16384 (retransmission covers $((16384 * 1000 / PPS)) ms)"
            ARQ_DEPTH=16384
        fi
    else
        ARQ_DEPTH=10
    fi
else
    ARQ_DEPTH=${VAL[arq-depth]}
fi

# Duplicate window: two RTTs (a retransmission can arrive that late) + 100 ms
if [ "${VAL[dup-window]}" = auto ]; then
    if [ $SIZED -eq 1 ]; then
        need=$(( PPS * (2 * RTT_MS + 100) / 1000 ))
        DUP_WORDS=$(pow2_up "$(ceil_div "$need" 64)")
        [ $DUP_WORDS -ge 16 ] || DUP_WORDS=16
        if [ $DUP_WORDS -gt 256 ]; then
            warn "rate x RTT needs a duplicate window of $need packets; capped at 16384 (16-bit sequence numbers)"
            DUP_WORDS=256
        fi
    else
        DUP_WORDS=16
    fi
else
    DUP_WORDS=$(pow2_up "$(ceil_div "${VAL[dup-window]}" 64)")
    [ $DUP_WORDS -le 256 ] || DUP_WORDS=256
fi
DUP_OLD=$(( (DUP_WORDS - 1) * 64 ))

# FEC receive slots: blocks open at the same time - about one per sending
# CPU, with room for parity that arrives a little late
if [ "${VAL[fec-slots]}" = auto ]; then
    cpus=$(nproc 2>/dev/null || echo 4)
    FEC_SLOTS=$(pow2_up $((cpus * 4)))
    [ $FEC_SLOTS -ge 16 ] || FEC_SLOTS=16
    [ $FEC_SLOTS -le 64 ] || FEC_SLOTS=64
else
    FEC_SLOTS=$(pow2_up "${VAL[fec-slots]}")
    [ $FEC_SLOTS -le 64 ] || FEC_SLOTS=64
fi

# 16-bit sequence numbers: retransmissions and late duplicates must arrive
# within the 16384 packets the receiver can still place. Longer outages
# are counted as a resync rather than loss.
SEQ_MS=""
if [ $SIZED -eq 1 ]; then
    SEQ_MS=$(( 16384 * 1000 / PPS ))
    span=$(( PPS * (2 * RTT_MS + 100) / 1000 ))
    [ $span -le 16384 ] || warn "16-bit sequence numbers cover only $SEQ_MS ms at this rate, less than 2 x RTT + 100 ms: late retransmissions and duplicates are miscounted (a larger shim class is needed)"
fi

# Settings in the units the programs use
FEC_PCT=${VAL[fec-threshold]%\%}
FEC_BP=$(awk -v p="$FEC_PCT" 'BEGIN{printf "%d", p*100 + 0.5}')
[ "$FEC_BP" -ge 1 ] && [ "$FEC_BP" -le 10000 ] || die "fec-threshold must be between 0.01 and 100"
COOLDOWN_MS=$(parse_dur "${VAL[fec-cooldown]}" s)
FEC_TIMEOUT=$(parse_dur "${VAL[fec-timeout]}" ms)
REPORT_MS=$(parse_dur "${VAL[report-interval]}" ms)
PROBE_MS=$(parse_dur "${VAL[probe-interval]}" s)
[ -n "${VAL[probe-rate]}" ] && PROBE_MS=$(awk -v r="${VAL[probe-rate]}" 'BEGIN{printf "%d", 1000 / r + 0.5}')
LOSS_SMOOTH=${VAL[loss-smoothing]}
CAP_WIN_MS=$(parse_dur "${VAL[capacity-window]:-0}" s)
TRAIN_MS=$(parse_dur "${VAL[probe-train]:-0}" ms)
TRAIN_MAX=${VAL[probe-train-max]}; TRAIN_SKIP=${VAL[probe-train-skip]}; CAP_PCT=${VAL[capacity-percentile]}
KEEPALIVE_MS=$(parse_dur "${VAL[keepalive]:-0}" s)
CONG_DELAY_MS=$(parse_dur "${VAL[congestion-delay]}" ms)
FEC_K=${VAL[fec-k]}; FEC_KMIN=${VAL[fec-k-min]}; FEC_KMAX=${VAL[fec-k-max]}; FEC_FLOOR=${VAL[fec-floor]}
PROBE_BACKOFF=${VAL[probe-backoff]}; PROBE_MIN=${VAL[probe-min-bytes]}; CONG_PCT=${VAL[congestion-pct]}
case "${VAL[fec-mode]}" in auto) FEC_FORCE=0 ;; off) FEC_FORCE=1 ;; on) FEC_FORCE=2 ;; esac
[ "$FEC_KMIN" -le "$FEC_KMAX" ] || die "fec-k-min ($FEC_KMIN) is larger than fec-k-max ($FEC_KMAX)"
[ "$COOLDOWN_MS" -ge 1 ] && [ "$COOLDOWN_MS" -le 3600000 ] || die "fec-cooldown must be 1 ms - 1 h"
[ "$FEC_TIMEOUT" -ge 1 ] && [ "$FEC_TIMEOUT" -le 2000 ] || die "fec-timeout must be 1-2000 ms"
[ "$REPORT_MS" -ge 100 ] && [ "$REPORT_MS" -le 60000 ] || die "report-interval must be 100 ms - 60 s"
[ "$PROBE_MS" -ge 10 ] && [ "$PROBE_MS" -le 86400000 ] || die "probe interval must be 10 ms - 1 day (probe-rate 0.00002-100)"
[ "$CONG_DELAY_MS" -ge 1 ] && [ "$CONG_DELAY_MS" -le 10000 ] || die "congestion-delay must be 1 ms - 10 s"
[ "$TRAIN_MS" -eq 0 ] || { [ "$TRAIN_MS" -ge 2 ] && [ "$TRAIN_MS" -le 1000 ]; } || die "probe-train must be 0 (pairs) or 2 ms - 1 s"
[ "$KEEPALIVE_MS" -eq 0 ] || { [ "$KEEPALIVE_MS" -ge 100 ] && [ "$KEEPALIVE_MS" -le 86400000 ]; } || die "keepalive must be 0 (off) or 100 ms - 1 day"
[ "$CAP_WIN_MS" -eq 0 ] || { [ "$CAP_WIN_MS" -ge 100 ] && [ "$CAP_WIN_MS" -le 86400000 ]; } || die "capacity-window must be 0 (off) or 100 ms - 1 day"
[ "$CAP_WIN_MS" -eq 0 ] || [ "$CAP_WIN_MS" -ge "$PROBE_MS" ] || warn "capacity-window ${VAL[capacity-window]} is shorter than the probe interval: at most one sample counts"
case "${VAL[arq-with-fec]}" in
    keep) ARQ_MODE=1; ARQ_FEC_DEPTH=$ARQ_DEPTH ;;
    off)  ARQ_MODE=2; ARQ_FEC_DEPTH=0 ;;
    *[a-z]*)
        [ $SIZED -eq 1 ] || die "arq-with-fec = ${VAL[arq-with-fec]}: a time needs link-rate and rtt"
        t=$(parse_dur "${VAL[arq-with-fec]}" ms)
        ARQ_MODE=3; ARQ_FEC_DEPTH=$(ceil_div $((PPS * t)) 1000)
        [ $ARQ_FEC_DEPTH -ge 1 ] || ARQ_FEC_DEPTH=1 ;;
    *)    ARQ_MODE=3; ARQ_FEC_DEPTH=${VAL[arq-with-fec]} ;;
esac
[ "$ARQ_FEC_DEPTH" -le "$ARQ_DEPTH" ] || ARQ_FEC_DEPTH=$ARQ_DEPTH
MEM_KB=$(( (ARQ_DEPTH * 1504 + FEC_SLOTS * 1504 + ARQ_DEPTH * 8 + FEC_SLOTS * 32 + DUP_WORDS * 8) / 1024 ))

# Carrier. Inside the dataplane every frame is Ethernet + 8-byte shim (+ the
# IP packet); with a UDP carrier one program at the end of egress turns it
# into a UDP packet and one at the start of ingress turns it back, so all the
# other programs are the same for every carrier.
#   ethernet    Ethernet | shim | IP                          +8 bytes
#   udp         Ethernet | IPv4 to peer | UDP | shim | IP      +36
#   udp-inline  Ethernet | IP (protocol UDP) | UDP (source port 0xB500 +
#               the protocol) | shim | L4                    +16 (+36 on
#               frames that carry no IP packet: parity, NAKs, reports)
CARRIER=${VAL[carrier]}
UDP_PORT=${VAL[udp-port]}
PATH_MTU=${VAL[path-mtu]}
case "$CARRIER" in
    ethernet)   C_OVH=8 ;;
    udp)        C_OVH=36 ;;
    udp-inline) C_OVH=36 ;;   # data 16; parity frames 36 + the longest member
esac
IP_MAX=$((PATH_MTU - C_OVH))
PROT_LIST=()
if [ -n "${VAL[protect]}" ]; then
    IFS=, read -ra PROT_LIST <<< "${VAL[protect]}"
fi
PEER_IP=0; PEER_PORT=$UDP_PORT; PEER_LEARN=0; LOCAL_IP=0; LOCAL_AUTO=0; LEARN_NET=0; LEARN_MASK=0
if [ "$CARRIER" != ethernet ]; then
    [ ${#PROT_LIST[@]} -gt 0 ] || die "carrier $CARRIER needs protect: the remote prefixes to carry (e.g. --protect 10.2.0.0/16, or 0.0.0.0/0 for all)"
    [ "$PRIO" -gt 10 ] 2>/dev/null || die "carrier $CARRIER needs --priority above 10 (it also uses N-10 on ingress)"
fi
if [ "$CARRIER" = udp ]; then
    case "${VAL[peer]}" in
        "") die "carrier udp needs peer: the peer's IPv4 address[:port], or learn" ;;
        learn) PEER_LEARN=1
               read -r LEARN_NET LEARN_MASK <<< "$(prefix_net_mask "${VAL[peer-learn-from]}")" ;;
        *:*) PEER_IP=$(ip2int "${VAL[peer]%%:*}"); PEER_PORT=${VAL[peer]#*:} ;;
        *)   PEER_IP=$(ip2int "${VAL[peer]}") ;;
    esac
    if [ "${VAL[local-address]}" = auto ]; then
        LOCAL_AUTO=1
        a=""
        [ -n "$IFACE" ] && a=$(ip -4 -o addr show dev "$IFACE" scope global 2>/dev/null | awk '{sub(/\/.*/, "", $4); print $4; exit}')
        if [ -n "$a" ]; then
            LOCAL_IP=$(ip2int "$a")
        elif [ -z "$SHOW" ] && [ $HINTS -eq 0 ]; then
            die "local-address auto: ${IFACE:-the interface} has no IPv4 address here; give --local-address (the address the interface sends from)"
        fi
    else
        LOCAL_IP=$(ip2int "${VAL[local-address]}")
    fi
else
    for k in peer local-address; do
        [ "${SRC[$k]}" = default ] || [ -z "${VAL[$k]}" ] || [ "${VAL[$k]}" = auto ] || warn "$k is only used with carrier udp"
    done
fi

if [ $HINTS -eq 1 ]; then
    IFQ=$(printf %q "$IFACE")
    if [ "$CARRIER" = ethernet ]; then
cat <<EOF
# Frames grow by 8 bytes: keep the link MTU at $PATH_MTU and use $IP_MAX for IP.
ip link set dev $IFQ mtu $PATH_MTU
# For every route through $IFQ (example for the connected subnet):
#   ip route change <subnet> dev $IFQ ... mtu lock $IP_MAX
EOF
    else
        echo "# Carrier $CARRIER: packets to the protected prefixes grow by $( [ "$CARRIER" = udp ] && echo "36 bytes (outer IPv4 + UDP + shim)" || echo "16 bytes (UDP + shim; parity frames 36)"),"
        echo "# so with a path MTU of $PATH_MTU they may be at most $IP_MAX bytes. For each prefix:"
        for p in "${PROT_LIST[@]}"; do
            echo "ip route replace $p via <gateway> dev $IFQ mtu lock $IP_MAX"
        done
        echo "# Traffic this host sends itself from a protected-site address (on lo or a LAN"
        echo "# interface) makes ARP ask the gateway with that address, which a gateway with"
        echo "# strict reverse-path filtering ignores; announce the interface address instead:"
        echo "sysctl -w net.ipv4.conf.$IFQ.arp_announce=2"
        echo "# UDP port $UDP_PORT carries the dataplane both ways: nothing listens on it, but a"
        echo "# firewall on the path must pass it. Programs run after netfilter on egress:"
        echo "# do not masquerade (SNAT) traffic to the protected prefixes on $IFQ."
        if [ "$CARRIER" = udp ]; then
            if [ $PEER_LEARN -eq 1 ]; then
                echo "# peer = learn: the peer's address and port are taken from its packets, so the"
                echo "# peer must send first (its NAT mapping is what this end answers to)."
            else
                echo "# Behind NAT, the mapping only stays open while this end sends. Keep something"
                echo "# flowing to the peer, e.g.: ping -i 15 <an address in a protected prefix>"
            fi
        else
            echo "# The routed WAN must carry the protected prefixes between the two ends, and both"
            echo "# ends must be on the path (control frames use the addresses of the traffic)."
        fi
    fi
cat <<EOF
# One TCP segment per packet, so every packet can be protected:
ip link set dev $IFQ gso_max_segs 1
ethtool -K $IFQ tso off gso off gro off
# Packets forwarded into $IFQ from other interfaces must not be GRO-merged
# (merged packets are sent unprotected): ethtool -K <lan-if> gro off
# Hosts or containers attached by veth pass their TSO/GSO packets through
# unchanged: on them, ethtool -K <if> tso off gso off
EOF
    if [ "$CARRIER" = ethernet ]; then
        echo "# On a VLAN subinterface, instead of route locks: ip link set dev $IFQ mtu $IP_MAX"
        echo "# (the parent stays at $PATH_MTU; set the same on the peer)"
    fi
    exit 0
fi

# ---------------------------------------------------------------- show / save

show_settings() {
    local k v
    echo "# Effective settings$( [ ${#RESOLVED_CHAIN[@]} -gt 0 ] && echo " (profile: ${RESOLVED_CHAIN[*]})" )"
    [ -n "$PROFILE" ] && [ -n "${PDESC[$PROFILE]}" ] && echo "# ${PDESC[$PROFILE]}"
    for k in "${KEYS[@]}"; do
        v=${VAL[$k]}; [ -n "$v" ] || v="-"
        printf "%-20s = %-10s # %-22s %s\n" "$k" "$v" "${SRC[$k]}" \
            "$( [ "${CLASS[$k]}" = runtime ] && echo "[runtime]" || echo "[regenerate]")"
    done
    echo "#"
    if [ $SIZED -eq 1 ]; then
        echo "# Sized for $(human_rate "$RATE_BPS"), RTT $RTT_MS ms: about $PPS packets/s of $SIZING bytes"
    else
        echo "# Not sized (no link-rate and rtt): default buffer sizes"
    fi
    echo "#   ARQ ring        $ARQ_DEPTH packets$( [ "$ARQ_MODE" = 3 ] && echo ", last $ARQ_FEC_DEPTH while FEC is on")"
    echo "#   duplicate window $((DUP_WORDS * 64)) packets"
    echo "#   FEC slots       $FEC_SLOTS"
    [ -n "$SEQ_MS" ] && echo "#   sequence space  $SEQ_MS ms (outages longer than this count as a resync, not loss)"
    echo "#   map memory      about $MEM_KB KiB per interface"
    echo "#   carrier         $CARRIER: IP packets up to $IP_MAX bytes are protected (path MTU $PATH_MTU)$( [ "$CARRIER" != ethernet ] && echo ", UDP port $UDP_PORT")"
    local w; for w in "${WARNINGS[@]}"; do echo "#   warning: $w"; done
}

if [ -n "$SHOW" ]; then show_settings; exit 0; fi

if [ -n "$SAVE" ]; then
    [[ "$SAVE" =~ ^[A-Za-z0-9_.-]{1,40}$ ]] || die "invalid profile name '$SAVE'"
    [ -n "$PROFILE" ] || [ ${#CLI[@]} -gt 0 ] || die "nothing to save: give --profile and/or settings"
    [ "$SAVE" != "$PROFILE" ] || die "--save-profile $SAVE would inherit from itself; choose another name"
    mkdir -p "$SAVE_DIR" || die "cannot create $SAVE_DIR"
    f="$SAVE_DIR/$SAVE.profile"
    {
        echo "# Saved by bpfc-dataplane-gen on $(date '+%Y-%m-%d %H:%M')"
        echo "description = ${DESCRIPTION:-${PROFILE:+based on $PROFILE}}"
        [ -n "$PROFILE" ] && echo "inherit = $PROFILE"
        for k in "${KEYS[@]}"; do if [ -n "${CLI[$k]+x}" ]; then echo "$k = ${CLI[$k]}"; fi; done
    } > "$f.tmp" && mv "$f.tmp" "$f" || die "cannot write $f"
    echo "saved profile $SAVE to $f"
    [ -n "$IFACE" ] || exit 0
    PROFILE=$SAVE; RESOLVED_CHAIN+=("$SAVE")
fi

[ -n "$IFACE" ] || { usage >&2; exit 2; }
IFACE_ENC=$(pct_encode "$IFACE")
# Two interfaces must not share a prefix (a hash collision, or the same
# --prefix twice): check the other interfaces generated into OUTDIR.
if [ "$OUTDIR" != "-" ] && [ -z "$SHOW" ]; then
    for f in "$OUTDIR"/*/egress/*.bpfc; do
        [ -r "$f" ] || continue
        other=${f#"$OUTDIR"/}; other=${other%%/*}
        [ "$other" = "$IFACE" ] && continue
        p=$(sed -n 's/^# dataplane: .* prefix=\([^ ]*\).*/\1/p' "$f" | head -1)
        [ "$p" = "$PREFIX" ] && die "map prefix $PREFIX is already used by $other (in $OUTDIR); choose one with --prefix"
    done
fi
[[ "$PRIO" =~ ^[0-9]+$ ]] && [ "$PRIO" -ge 1 ] && [ "$PRIO" -le 65000 ] || die "--priority must be 1-65000"

# Maps (pinned under bpfcd's map_dir):
TX=${PREFIX}_tx      # sender state, settings in force, what the peer reports
RX=${PREFIX}_rx      # receiver state
PC=${PREFIX}_pcpu    # per-CPU FEC block state, key cpu*2 (+1 = block start time)
CFG=${PREFIX}_cfg    # runtime overrides (bpfc -w); 0 or missing = generated default
ARQ=${PREFIX}_arq    # retransmit ring: shim + IP packet per slot
ATAG=${PREFIX}_atag  # retransmit ring tags: seq << 16 | length (array)
ACC=${PREFIX}_ftx    # per-CPU parity accumulator
FRX=${PREFIX}_frx    # receive-side block accumulators
FSL=${PREFIX}_fsl    # receive-side block state: slot*4 + 0 block+1, 1 members, 2 seq-xor (array)
DUP=${PREFIX}_dup    # duplicate bitmap, 64 sequences per word (array)

P_EGRESS=$PRIO
P_FEC=$((PRIO + 10))
P_CTRL=$PRIO
P_PARITY=$((PRIO + 10))
P_DATA=$((PRIO + 20))
P_DELIVER=$((PRIO + 30))

emit() {   # emit <dir> <prio> <name>; reads the program on stdin
    local dir="$1" prio="$2" name="$3"
    if [ "$OUTDIR" = "-" ]; then
        echo "### $IFACE_ENC/$dir/$prio.bpfc ($name)"; cat; echo
    else
        mkdir -p "$OUTDIR/$IFACE/$dir"
        cat > "$OUTDIR/$IFACE/$dir/$prio.bpfc.tmp"
        mv "$OUTDIR/$IFACE/$dir/$prio.bpfc.tmp" "$OUTDIR/$IFACE/$dir/$prio.bpfc"
        echo "wrote $OUTDIR/$IFACE/$dir/$prio.bpfc ($name)"
    fi
}

# Switching back to the Ethernet carrier: remove the UDP carrier programs of
# an earlier run (only files this generator wrote).
if [ "$OUTDIR" != "-" ] && [ "$CARRIER" = ethernet ]; then
    for f in "$OUTDIR/$IFACE/ingress/$((PRIO - 10)).bpfc" "$OUTDIR/$IFACE/egress/$((PRIO + 40)).bpfc"; do
        if [ -f "$f" ] && head -1 "$f" | grep -q '^# Generated by bpfc-dataplane-gen'; then
            rm -f -- "$f" && echo "removed $f (carrier program of an earlier run)"
        fi
    done
fi

PNAME=${PROFILE:-none}
SETTINGS_LINE=""
for k in "${KEYS[@]}"; do [ -n "${VAL[$k]}" ] && SETTINGS_LINE+=" $k=${VAL[$k]}"; done
HEADER="# Generated by bpfc-dataplane-gen v$VERSION for $IFACE_ENC (profile $PNAME) - regenerate, do not edit.
# dataplane: version=$VERSION iface=$IFACE_ENC prefix=$PREFIX profile=$PNAME link_rate=${RATE_BPS:-0} rtt_ms=${RTT_MS:-0} sizing_bytes=$SIZING arq_depth=$ARQ_DEPTH dup_words=$DUP_WORDS fec_slots=$FEC_SLOTS nak_max=$NAK_MAX arq_mode=$ARQ_MODE arq_fec_depth=$ARQ_FEC_DEPTH fec_bp=$FEC_BP cooldown_ms=$COOLDOWN_MS k=$FEC_K kmin=$FEC_KMIN kmax=$FEC_KMAX floor=$FEC_FLOOR timeout_ms=$FEC_TIMEOUT fec_mode=$FEC_FORCE report_ms=$REPORT_MS probe_ms=$PROBE_MS backoff=$PROBE_BACKOFF probe_min=$PROBE_MIN cong_pct=$CONG_PCT cong_delay_ms=$CONG_DELAY_MS loss_smooth=$LOSS_SMOOTH cap_window_ms=$CAP_WIN_MS train_ms=$TRAIN_MS train_max=$TRAIN_MAX train_skip=$TRAIN_SKIP cap_pct=$CAP_PCT keepalive_ms=$KEEPALIVE_MS carrier=$CARRIER udp_port=$UDP_PORT ip_max=$IP_MAX peer=$( [ $PEER_LEARN -eq 1 ] && echo learn || echo "$(int2ip $PEER_IP):$PEER_PORT") local=$(int2ip $LOCAL_IP) protect=$(IFS=,; echo "${PROT_LIST[*]:-all}")
# maps: $TX $RX $PC $CFG $ARQ $ATAG $ACC $FRX $FSL $DUP
# settings:$SETTINGS_LINE"

# ---------------------------------------------------------------- carrier code

# carrier_select_code: in the first egress program, after "match ip": leave
# alone what is not for the peer (not in protect), and send unprotected what
# the carrier cannot take (no peer or local address yet; for udp-inline,
# IP options or fragments).
carrier_select_code() {
    local p net mask
    if [ ${#PROT_LIST[@]} -gt 0 ]; then
        echo "# Only packets to the protected prefixes ($(IFS=,; echo "${PROT_LIST[*]}"))."
        echo "get ip-dst PD;"
        echo "decl PDV 8;"
        echo "set val PDV %PD;"
        echo "free PD;"
        echo "decl PSEL 8;"
        echo "decl PT 8;"
        echo "decl PN 8;"
        for p in "${PROT_LIST[@]}"; do
            read -r net mask <<< "$(prefix_net_mask "$p")"
            if [ "$mask" -eq 0 ]; then
                echo "set val PSEL 1;"
            else
                echo "set val PT %PDV;"
                echo "set val PN $mask;"
                echo "calc and PT %PN;"
                echo "set val PN $net;"
                echo "if PT eq %PN;"
                echo "  set val PSEL 1;"
                echo "end-if;"
            fi
        done
        echo "free PN;"
        echo "free PT;"
        echo "free PDV;"
        echo "if PSEL eq 0;"
        echo "  set skb-cb 0 0;"
        echo "  continue;"
        echo "end-if;"
        echo "free PSEL;"
    fi
    case "$CARRIER" in
        udp)
cat <<EOC
# The peer's address and ours (runtime setting, else learned, else generated);
# without them the packet goes out unprotected.
get map $CFG 19 PI;
if PI eq 0;
  get map $TX 60 PI;
end-if;
if PI eq 0;
  set val PI $PEER_IP;
end-if;
get map $CFG 21 LI;
if LI eq 0;
  get map $TX 62 LI;
end-if;
if LI eq 0;
  set val LI $LOCAL_IP;
end-if;
calc mul PI %LI;
if PI eq 0;
  calc-map add $TX 65 1;
  set skb-cb 0 0;
  continue;
end-if;
free LI;
free PI;
EOC
            ;;
        udp-inline)
cat <<EOC
# The IP header becomes the outer header: 20 bytes, not a fragment.
get bytes 14 1 VH;
get bytes 20 2 FR;
calc and FR 0x3FFF;
if VH ne 0x45;
  set val FR 1;
end-if;
if FR ne 0;
  calc-map add $TX 4 1;
  set skb-cb 0 0;
  continue;
end-if;
free FR;
free VH;
EOC
            ;;
    esac
}

# keepalive_code (carrier udp): when nothing went to the peer for keepalive
# ms (cfg 22; TX 67 = last frame the carrier sent), send it a keepalive
# (type 6) made from a clone of this packet: the clone gets EtherType 0x88B5
# and a type 6 shim, then the original's bytes are put back. The carrier
# program cuts the clone to 60 bytes, so none of the packet leaves with it.
keepalive_code() {
    [ "$CARRIER" = udp ] || return 0
cat <<EOC
# Keepalive for a NAT on the path (see keepalive).
get map $CFG 22 KA;
if KA eq 0;
  set val KA $KEEPALIVE_MS;
end-if;
if KA gt 0;
  if KA lt 86400000;
    get time KN;
    calc div KN 1000000;
    get map $TX 67 KL;
    calc sub KL %KN;
    calc add KL %KA;
    # KL = last + interval - now: negative (top bit set) when one is due
    calc rsh KL 63;
    # not from a GSO packet (it could not be cut down)
    get len KZ;
    if KZ gt 1514;
      set val KL 0;
    end-if;
    free KZ;
    if KL eq 1;
      set map $TX 67 %KN;
      get bytes 12 2 KE;
      get bytes 14 8 KB;
      set eth-proto 0x88B5;
      decl KW 8;
      set val KW 6;
      calc lsh KW 61;
      calc hton KW 64;
      set bytes 14 8 %KW;
      free KW;
      get skb-ifindex KI;
      clone %KI egress;
      free KI;
      calc hton KB 64;
      set bytes 14 8 %KB;
      calc hton KE 16;
      set bytes 12 2 %KE;
      calc-map add $TX 68 1;
      free KB;
      free KE;
    end-if;
    free KL;
    free KN;
  end-if;
end-if;
free KA;
EOC
}

# udp-inline: routers on the path lower the TTL and may rewrite the TOS
# (DSCP remarking, ECN CE), and the receiver delivers them as they arrive. So
# FEC leaves them out: members are folded with TOS, TTL and header checksum
# zeroed (fec_norm_code before the fold, fec_restore_code after), and a
# rebuilt packet takes TOS and TTL from its parity frame, which travels with
# those of the packet it was made from (skb->cb 3: 0xB5A1 << 16 | TTL << 8 | TOS).
fec_norm_code() {
    [ "$CARRIER" = udp-inline ] || return 0
cat <<EOC
# udp-inline: fold without TOS, TTL and header checksum
get bytes 22 8 NA;
get bytes 30 4 NB;
decl NZ 8;
set val NZ %NA;
decl NM 8;
set val NM 0xFF;
calc lsh NM 48;
calc not NM;
calc and NZ %NM;
calc hton NZ 64;
set bytes 22 8 %NZ;
decl NY 4;
set val NY %NB;
calc and NY 0x00FF0000;
calc hton NY 32;
set bytes 30 4 %NY;
free NY;
free NZ;
EOC
}
fec_restore_code() {
    [ "$CARRIER" = udp-inline ] || return 0
cat <<EOC
calc hton NA 64;
set bytes 22 8 %NA;
calc hton NB 32;
set bytes 30 4 %NB;
free NM;
free NB;
free NA;
EOC
}

# csum_add <var> <bits>: add the 16-bit words of a big-endian header value
# to CS (CT is scratch). csum_fold: CS becomes the IPv4 header checksum.
csum_add() {
    local v=$1 b=$2 sh
    for ((sh = b - 16; sh >= 0; sh -= 16)); do
        echo "set val CT %$v;"
        [ $sh -gt 0 ] && echo "calc rsh CT $sh;"
        echo "calc and CT 0xFFFF;"
        echo "calc add CS %CT;"
    done
}
csum_fold() {
    local i
    for i in 1 2; do
        echo "set val CT %CS;"
        echo "calc rsh CT 16;"
        echo "calc and CS 0xFFFF;"
        echo "calc add CS %CT;"
    done
    echo "calc xor CS 0xFFFF;"
}

########################################################################
# Egress, first: encapsulate every IPv4 packet (sequence number, timestamp)
# and keep a copy for ARQ.
########################################################################
emit egress $P_EGRESS "encapsulate" <<EOF
$HEADER
#
# Shim (8 bytes after the Ethernet header, EtherType 0x88B5), big-endian:
#   type:3 flags:5 | k:4 idx:4 | seq:16 | block:8 | ts:24 (4 us units)
# flags: 0x10 FEC member, 0x08 probe 1, 0x04 probe 2, 0x02 FEC on,
#        0x01 sequence restarted (first 1024 packets)
shared-buffer-map $ARQ $ARQ_DEPTH 1504;
array-map $ATAG $ARQ_DEPTH;

# Our own frames (clones re-entering egress, NAK, report, retransmission)
# pass; clear the hand-over mark so the FEC program leaves them alone.
match eth-proto 0x88B5;
  set skb-cb 0 0;
  continue;
end-match;
match ip;
$(keepalive_code)$(carrier_select_code)

# Packets that do not fit (GSO, or IP longer than $IP_MAX) go out unprotected.
get len FLEN;
if FLEN gt $((14 + IP_MAX));
  calc-map add $TX 4 1;
  set skb-cb 0 0;
  continue;
end-if;
free FLEN;

get ip-len IPL2;
decl IPL 8;
set val IPL %IPL2;
free IPL2;
calc-map add $TX 1 1 SEQ;
calc-map add $TX 2 1;
calc-map add $TX 3 %IPL;
get time NOW;
get map $TX 6 FK;
# Start-up: the controller only runs when the peer's first report arrives,
# so apply "fec-mode on" and the FEC floor from the first packet.
if FK eq 0;
  if SEQ lt 64;
    decl FM 8;
    get map $CFG 14 FM;
    if FM eq 0;
      set val FM $FEC_FORCE;
    end-if;
    if FM eq 2;
      get map $CFG 3 FK;
      if FK eq 0;
        set val FK $FEC_K;
      end-if;
    end-if;
    if FM ne 1;
      if FK eq 0;
        get map $CFG 16 FM;
        if FM eq 0;
          set val FM $FEC_FLOOR;
        end-if;
        if FM gt 0;
          if FM le 15;
            set val FK %FM;
          end-if;
        end-if;
      end-if;
    end-if;
    free FM;
    if FK gt 15;
      set val FK 15;
    end-if;
    if FK gt 0;
      set map $TX 6 %FK;
      calc-map add $TX 8 1;
      set map $TX 22 %NOW;
    end-if;
  end-if;
end-if;

decl W 8;
set val W 1;
calc lsh W 61;
decl T 8;
if FK gt 0;
  # FEC on: flag 0x02 and the ratio in use (k), on every packet
  set val T 0x02;
  calc lsh T 56;
  calc or W %T;
  set val T %FK;
  calc and T 0xF;
  calc lsh T 52;
  calc or W %T;
end-if;
set val T %SEQ;
calc and T 0xFFFF;
calc lsh T 32;
calc or W %T;
# 0x01: this sequence just started (map created), lets the peer resync
if SEQ lt 1024;
  set val T 0x01;
  calc lsh T 56;
  calc or W %T;
end-if;
set val T %NOW;
calc div T 4000;
calc and T 0xFFFFFF;
calc or W %T;
free NOW;
insert-l2 8 0x88B5;
set val T %W;
calc hton T 64;
set bytes 14 8 %T;
free W;

# ARQ: keep shim + packet; tag = seq << 16 | stored length.
decl SAVE 8;
set val SAVE 1;
if FK gt 0;
  get map $CFG 8 MODE;
  if MODE eq 0;
    set val MODE $ARQ_MODE;
  end-if;
  if MODE eq 2;
    set val SAVE 0;
  end-if;
  free MODE;
end-if;
if SAVE eq 1;
  set val T %SEQ;
  calc mod T $ARQ_DEPTH;
  decl SLEN 8;
  set val SLEN %IPL;
  calc add SLEN 8;
  save-packet-keyed $ARQ %T %SLEN 14 0;
  set val SAVE %SEQ;
  calc lsh SAVE 16;
  calc or SAVE %SLEN;
  set map $ATAG %T %SAVE;
  free SLEN;
end-if;
free SAVE;

# Hand over to the FEC program: cb[0] = 0xDA7B0000, cb[1] = seq.
set val T 0xDA7B;
calc lsh T 16;
set skb-cb 0 %T;
set skb-cb 1 %SEQ;
continue;
EOF

########################################################################
# Egress, second: fold the packet into this CPU's FEC block, send parity
# when the block is full or old, send packet-pair probes.
########################################################################
emit egress $P_FEC "fec" <<EOF
$HEADER
buffer-map $ACC 1504;
match eth-proto 0x88B5;
get skb-cb 0 C0;
calc rsh C0 16;
if C0 ne 0xDA7B;
  continue;
end-if;
free C0;
set skb-cb 0 0;
get skb-cb 1 SQ;
get time NOW;
get map $TX 6 FK;
get bytes 24 2 IPL;
get bytes 31 1 PROTO;

# FEC members: IHL 5 (fixed checksum offsets below) and not SCTP (its CRC
# may still be filled in by the NIC).
decl EL 8;
get bytes 22 1 VIHL;
if VIHL eq 0x45;
  set val EL 1;
end-if;
free VIHL;
if PROTO eq 132;
  set val EL 0;
end-if;

# Per-CPU block state: open:1 | k:4 (bits 59-56) | idx:4 (55-52) | block:8 (51-44)
#   | length-or:12 (43-32) | seq-xor:16 (31-16)
get cpu CPU;
decl PK 8;
set val PK %CPU;
free CPU;
calc mul PK 2;
get map $PC %PK ST;
# ACT: 1 = member of a block, 2 = this packet closes the block, 4 = flush the
# open block (timed out or FEC turned off) with this packet as the carrier.
decl ACT 8;
decl T 8;
set val T %ST;
calc rsh T 63;
if T eq 1;
  if FK eq 0;
    set val ACT 4;
  end-if;
  calc add PK 1;
  get map $PC %PK BST;
  calc sub PK 1;
  set val T %NOW;
  calc sub T %BST;
  free BST;
  get map $CFG 12 TO;
  if TO eq 0;
    set val TO $FEC_TIMEOUT;
  end-if;
  calc mul TO 1000000;
  if T gt %TO;
    set val ACT 4;
  end-if;
  free TO;
  if EL eq 0;
    set val ACT 0;
  end-if;
else;
  if EL eq 1;
    if FK gt 0;
      calc-map add $TX 5 1 BIDV;
      set val ST 1;
      calc lsh ST 63;
      set val T %FK;
      calc lsh T 56;
      calc or ST %T;
      set val T %BIDV;
      free BIDV;
      calc and T 0xFF;
      calc lsh T 44;
      calc or ST %T;
      calc add PK 1;
      set map $PC %PK %NOW;
      calc sub PK 1;
    end-if;
  end-if;
end-if;
if ACT eq 0;
  if EL eq 1;
    if FK gt 0;
      set val ACT 1;
    end-if;
  end-if;
end-if;
free EL;

get bytes 14 8 W;
if ACT eq 1;
  calc-map add $TX 24 1;
  # shim: member flag, k and idx of this block (replacing the k written by
  # the first program: K may have changed since the block started), block
  set val T 0xFF;
  calc lsh T 48;
  calc not T;
  calc and W %T;
  set val T 0x10;
  calc lsh T 56;
  calc or W %T;
  set val T %ST;
  calc rsh T 52;
  calc and T 0xFF;
  calc lsh T 48;
  calc or W %T;
  set val T %ST;
  calc rsh T 44;
  calc and T 0xFF;
  calc lsh T 24;
  calc or W %T;
  set val T %W;
  calc hton T 64;
  set bytes 14 8 %T;

  # Fold the IP packet into the accumulator. A TCP/UDP packet may still carry
  # a partial checksum that the kernel or NIC completes after this program,
  # so fold in the checksum it will have: recovered packets then carry their
  # real checksum and the receiving kernel verifies them.
  # CO = offset of the checksum swapped in (0 = none).
  decl CO 8;
  get bytes 28 2 FR;
  calc and FR 0x3FFF;
  if FR eq 0;
    if PROTO eq 6;
      set val CO 58;
    end-if;
    if PROTO eq 17;
      get bytes 48 2 CS;
      if CS ne 0;
        set val CO 48;
      end-if;
    end-if;
  end-if;
  free FR;
  if CO eq 58;
    get bytes 58 2 CS;
    calc-csum tcp TV 22 1500;
    calc hton TV 16;
    set bytes 58 2 %TV;
  end-if;
  if CO eq 48;
    get bytes 48 2 CS;
    calc-csum udp TV 22 1500;
    calc hton TV 16;
    set bytes 48 2 %TV;
  end-if;
  free TV;
$(fec_norm_code)
  xor-packet $ACC %IPL 22 0;
$(fec_restore_code)
  calc hton CS 16;
  if CO eq 58;
    set bytes 58 2 %CS;
  end-if;
  if CO eq 48;
    set bytes 48 2 %CS;
  end-if;
  free CS;
  free CO;

  # length-or, seq-xor, idx + 1; full block -> ACT 2
  set val T %IPL;
  calc lsh T 32;
  calc or ST %T;
  set val T %SQ;
  calc and T 0xFFFF;
  calc lsh T 16;
  calc xor ST %T;
  set val T 1;
  calc lsh T 52;
  calc add ST %T;
  set val T %ST;
  calc rsh T 52;
  set val SQ %T;
  calc and SQ 0xF;
  calc rsh T 4;
  calc and T 0xF;
  if SQ ge %T;
    set val ACT 2;
  else;
    set map $PC %PK %ST;
  end-if;
end-if;
free SQ;

# Parity: send this packet first (clone), then turn it into the parity frame.
if ACT ge 2;
  set map $PC %PK 0;
  get skb-ifindex IFX;
  clone %IFX egress;
  # parity length = OR of member lengths, 38..$IP_MAX
  decl PL 8;
  set val PL %ST;
  calc rsh PL 32;
  calc and PL 0xFFF;
  if PL gt $IP_MAX;
    set val PL $IP_MAX;
  end-if;
  if PL lt 38;
    set val PL 38;
  end-if;
$( [ "$CARRIER" = udp-inline ] && cat <<EOC
  # udp-inline: the parity frame travels with this packet's TOS and TTL
  get bytes 23 1 QT;
  get bytes 30 1 QL;
  set val T 0xB5A1;
  calc lsh T 8;
  calc or T %QL;
  calc lsh T 8;
  calc or T %QT;
  set skb-cb 3 %T;
  free QL;
  free QT;
EOC
)
  set val T %PL;
  calc add T 22;
  set len %T;
  load-packet $ACC %PL 0 22;
  xor-packet $ACC %PL 22 0;
  # header: type 2 | FEC on | n | saved checksum bytes | block | code | seq-xor
  set val W 2;
  calc lsh W 61;
  set val T 0x02;
  calc lsh T 56;
  calc or W %T;
  set val T %ST;
  calc rsh T 52;
  calc and T 0xF;
  calc lsh T 48;
  calc or W %T;
  set val T %ST;
  calc rsh T 44;
  calc and T 0xFF;
  calc lsh T 24;
  calc or W %T;
  set val T %ST;
  calc rsh T 16;
  calc and T 0xFFFF;
  calc or W %T;
  # The kernel or NIC may still write this packet's TCP/UDP checksum into the
  # parity bytes; keep the real bytes in the header so the receiver can undo it.
  if PROTO eq 6;
    get bytes 58 2 CB;
    set val T 2;
  else;
    if PROTO eq 17;
      get bytes 48 2 CB;
      set val T 1;
    else;
      decl CB 2;
      set val T 0;
    end-if;
  end-if;
  calc lsh T 16;
  calc or W %T;
  set val T %CB;
  calc lsh T 32;
  calc or W %T;
  calc hton W 64;
  set bytes 14 8 %W;
  calc-map add $TX 9 1;
  if ACT eq 4;
    calc-map add $TX 23 1;
  end-if;
  continue;
end-if;
free ST;
free PK;
free PROTO;

# Packet-pair probe: this packet goes out twice, back to back, flagged
# probe 1 and probe 2. The receiver measures the gap and drops the copy.
get map $TX 10 PLAST;
set val T %NOW;
calc div T 1000000;
calc sub T %PLAST;
get map $CFG 6 IV;
if IV eq 0;
  set val IV $PROBE_MS;
end-if;
if FK gt 0;
  get map $CFG 7 BO;
  if BO eq 0;
    set val BO $PROBE_BACKOFF;
  end-if;
  calc mul IV %BO;
  free BO;
end-if;
if T ge %IV;
  free IV;
  get map $CFG 13 PMIN;
  if PMIN eq 0;
    set val PMIN $PROBE_MIN;
  end-if;
  if IPL ge %PMIN;
    set val T %NOW;
    calc div T 1000000;
    set map $TX 10 %T;
    # Probe train (probe-train, cfg 23: ms; >= 1 day: pairs): as many
    # packets as cross the link in that long at the rate the peer measured
    # (TX 36; 16 before there is one), 3 .. probe-train-max (cfg 24). A pair
    # is a train of 2. The receiver times it from packet S (probe-train-skip
    # percent in, cfg 25 = percent + 1) to the last one.
    decl PN 8;
    set val PN 2;
    get map $CFG 23 SP;
    if SP eq 0;
      set val SP $TRAIN_MS;
    end-if;
    if SP gt 0;
      if SP lt 86400000;
        get map $TX 36 EST;
        set val PN 16;
        if EST gt 0;
          set val PN %SP;
          calc mul PN %EST;
          set val T %IPL;
          calc add T $((38 + C_OVH));
          calc mul T 8;
          calc div PN %T;
        end-if;
        free EST;
        get map $CFG 24 PX;
        if PX eq 0;
          set val PX $TRAIN_MAX;
        end-if;
        if PN gt %PX;
          set val PN %PX;
        end-if;
        free PX;
        if PN lt 3;
          set val PN 3;
        end-if;
      end-if;
    end-if;
    free SP;
    if PN gt 256;
      set val PN 256;
    end-if;
    get map $CFG 25 SK;
    if SK eq 0;
      set val SK $((TRAIN_SKIP + 1));
    end-if;
    calc sub SK 1;
    calc mul SK %PN;
    calc div SK 100;
    # head: probe 1
    set val T 0x08;
    calc lsh T 56;
    calc or W %T;
    set val T %W;
    calc hton T 64;
    set bytes 14 8 %T;
    get skb-ifindex IFX;
    clone %IFX egress;
    # fillers (probe 1 + 2 flags): the timestamp field carries S << 12 | index
    decl FC 8;
    set val FC %PN;
    calc sub FC 2;
    if FC gt 0;
      decl FI 8;
      decl FW 8;
      set val FI 1;
      start-loop;
        set val FW %W;
        calc rsh FW 24;
        calc lsh FW 24;
        set val T 0x04;
        calc lsh T 56;
        calc or FW %T;
        set val T %SK;
        calc lsh T 12;
        calc or T %FI;
        calc or FW %T;
        calc hton FW 64;
        set bytes 14 8 %FW;
        clone %IFX egress;
        calc add FI 1;
        calc sub FC 1;
      loop FC;
      free FW;
      free FI;
    end-if;
    free FC;
    free SK;
    # tail: this packet, probe 2
    set val T 0x0C;
    calc lsh T 56;
    calc xor W %T;
    calc hton W 64;
    set bytes 14 8 %W;
    calc-map add $TX 11 1;
    calc-map add $TX 69 %PN;
    free PN;
  end-if;
end-if;
continue;
EOF

# cap_percentile_code: with capacity-percentile (cfg 26: 1-100; above 100:
# off), V = that percentile of the samples in the ring (60-75, the ones in
# the window; 57 counts them): the K-th largest, K = n - ceil(n * p / 100)
# + 1, found bit by bit from the top (is there K samples >= R | bit?). No
# branches, so the verifier's cost stays one pass.
cap_percentile_code() {
    local i b
cat <<EOC
get map $CFG 26 CP;
if CP eq 0;
  set val CP $CAP_PCT;
end-if;
get map $RX 57 CN;
if CP gt 0;
  if CP le 100;
    if CN gt 0;
      decl K 8;
      set val K %CN;
      calc mul K %CP;
      calc add K 99;
      calc div K 100;
      calc sub K %CN;
      calc sub K 1;
      calc mul K -1;
      decl R 8;
      decl C 8;
      decl CC 8;
      decl Q 8;
EOC
    for i in $(seq 0 15); do echo "      get map $RX $((60 + i)) S$i;"; done
    for b in $(seq 24 -1 0); do
        echo "      set val C %R;"
        echo "      calc or C $((1 << b));"
        echo "      set val CC 0;"
        for i in $(seq 0 15); do
            echo "      set val Q %C;"
            echo "      calc sub Q 1;"
            echo "      calc sub Q %S$i;"
            echo "      calc rsh Q 63;"
            echo "      calc add CC %Q;"
        done
        # CC >= K: (K - 1 - CC) is negative
        echo "      set val Q %K;"
        echo "      calc sub Q 1;"
        echo "      calc sub Q %CC;"
        echo "      calc rsh Q 63;"
        echo "      calc mul Q $((1 << b));"
        echo "      calc or R %Q;"
    done
    for i in $(seq 15 -1 0); do echo "      free S$i;"; done
cat <<EOC
      set val V %R;
      free Q;
      free CC;
      free C;
      free R;
      free K;
    end-if;
  end-if;
end-if;
free CN;
free CP;
EOC
}

# cap_window_code: with capacity-window (cfg 18), drop probe samples older
# than the window from the ring (60-75, taken at 76-91), and count the ones
# left (57): the estimate takes its share from the top of these. The count
# has no branches: (0 - v | v) >> 63 is 1 for any v > 0.
cap_window_code() {
    local i
    cat <<EOC
            decl CW 8;
            decl CA 8;
            decl CN 8;
            get map $CFG 18 CW;
            if CW eq 0;
              set val CW $CAP_WIN_MS;
            end-if;
            if CW gt 0;
EOC
    for i in $(seq 0 15); do
        cat <<EOC
              get map $RX $((76 + i)) CA;
              set val CN %TS;
              calc sub CN %CA;
              if CN gt %CW;
                set map $RX $((60 + i)) 0;
              end-if;
EOC
    done
    echo "            end-if;"
    echo "            set val CN 0;"
    for i in $(seq 0 15); do
        cat <<EOC
            get map $RX $((60 + i)) CA;
            set val CW 0;
            calc sub CW %CA;
            calc or CW %CA;
            calc rsh CW 63;
            calc add CN %CW;
EOC
    done
    cat <<EOC
            set map $RX 57 %CN;
            free CN;
            free CA;
            free CW;
            free TS;
EOC
}

########################################################################
# Ingress, first: control frames for our own sending direction.
#   REPORT (type 5): store what the peer measured, run the FEC controller.
#   NAK (type 4): retransmit from the ARQ ring.
########################################################################
{
cat <<EOF
$HEADER
shared-buffer-map $ARQ $ARQ_DEPTH 1504;
array-map $ATAG $ARQ_DEPTH;

# Packet pair, receiving side. While a pair is open (probe 1 seen, probe 2
# not yet), every frame that arrives crossed the bottleneck between the two
# copies, so its bytes count towards the gap: frames the sender's queue put
# between the copies do not make the link look slower. 42 = bytes so far.
get map $RX 18 PT;
if PT ne 0;
  get time PN;
  calc sub PN %PT;
  if PN gt 1000000000;
    set map $RX 18 0;
  else;
    get len PL4;
    decl PB 8;
    set val PB %PL4;
    free PL4;
    calc add PB 24;$( [ "$CARRIER" != ethernet ] && printf '\n    # the UDP carrier headers the first program removed\n    get bytes 12 2 PET;\n    if PET eq 0x88B5;\n      calc add PB %d;\n    end-if;\n    free PET;' $( [ "$CARRIER" = udp ] && echo 28 || echo 12))
    calc-map add $RX 42 %PB;
    free PB;
  end-if;
  free PN;
end-if;
free PT;

match eth-proto 0x88B5;
get bytes 14 8 W;
decl TY 8;
set val TY %W;
calc rsh TY 61;
$( [ "$CARRIER" = udp ] && printf '%s\n' '# keepalive (carrier udp): only there to keep a NAT mapping open' 'if TY eq 6;' "  calc-map add $RX 95 1;" '  drop;' 'end-if;')

if TY eq 1;
  decl PF 8;
  set val PF %W;
  calc rsh PF 56;
  calc and PF 0x0C;
  if PF ne 0;
    decl PS 8;
    set val PS %W;
    calc rsh PS 32;
    calc and PS 0xFFFF;
    get time PN;
    if PF eq 0x08;
      # probe 1: open the pair (or train)
      calc add PS 1;
      set map $RX 17 %PS;
      set map $RX 42 0;
      set map $RX 18 %PN;
      set map $RX 59 0;
    end-if;
    if PF eq 0x0C;
      # train filler: the first one at index S or later restarts the timing
      # (59 = restarted), so the first frame and a scheduler's ramp-up are
      # left out; fillers are copies, not counted as duplicates
      calc-map add $RX 96 1;
      get map $RX 17 P1;
      calc sub P1 1;
      get map $RX 59 STD;
      if P1 eq %PS;
        if STD eq 0;
          decl FX 8;
          decl FS 8;
          set val FX %W;
          calc and FX 0xFFF;
          set val FS %W;
          calc rsh FS 12;
          calc and FS 0xFFF;
          if FS gt 0;
            if FX ge %FS;
              set map $RX 59 1;
              set map $RX 42 0;
              set map $RX 18 %PN;
            end-if;
          end-if;
          free FS;
          free FX;
        end-if;
      end-if;
      free STD;
      free P1;
      drop;
    end-if;
    if PF eq 0x04;
      # probe 2 (a copy of probe 1): sample = bytes since probe 1 / gap,
      # frame + 24 bytes preamble/IFG/FCS each, in kbit/s
      get map $RX 17 P1;
      calc sub P1 1;
      get map $RX 18 PT;
      set map $RX 18 0;
      if PT ne 0;
        if P1 eq %PS;
          calc sub PN %PT;
          if PN gt 0;
            get map $RX 42 PB;
            calc mul PB 8000000;
            calc div PB %PN;
            set map $RX 52 %PB;
            # keep the last 16 samples (60-75); the estimate is the fourth
            # largest (about the 80th percentile): delay jitter and cross
            # traffic only stretch a gap, a receiver that batches packets
            # shrinks it, so the estimate stays right while at least 4 of
            # 16 pairs got through cleanly and at most 3 were squeezed
            calc-map add $RX 43 1 PI;
            calc mod PI 16;
            calc add PI 60;
            set map $RX %PI %PB;
            # when it was taken (ms), for capacity-window: 76-91
            calc add PI 16;
            get time TS;
            calc div TS 1000000;
            set map $RX %PI %TS;
            free PI;
$(cap_window_code)
            decl M1 8;
            decl M2 8;
            decl M3 8;
            decl M4 8;
            decl PV 8;
            get map $RX 60 PV;
            if PV gt %M1;
              set val M4 %M3;
              set val M3 %M2;
              set val M2 %M1;
              set val M1 %PV;
            else;
              if PV gt %M2;
                set val M4 %M3;
                set val M3 %M2;
                set val M2 %PV;
              else;
                if PV gt %M3;
                  set val M4 %M3;
                  set val M3 %PV;
                else;
                  if PV gt %M4;
                    set val M4 %PV;
                  end-if;
                end-if;
              end-if;
            end-if;
            get map $RX 61 PV;
            if PV gt %M1;
              set val M4 %M3;
              set val M3 %M2;
              set val M2 %M1;
              set val M1 %PV;
            else;
              if PV gt %M2;
                set val M4 %M3;
                set val M3 %M2;
                set val M2 %PV;
              else;
                if PV gt %M3;
                  set val M4 %M3;
                  set val M3 %PV;
                else;
                  if PV gt %M4;
                    set val M4 %PV;
                  end-if;
                end-if;
              end-if;
            end-if;
            get map $RX 62 PV;
            if PV gt %M1;
              set val M4 %M3;
              set val M3 %M2;
              set val M2 %M1;
              set val M1 %PV;
            else;
              if PV gt %M2;
                set val M4 %M3;
                set val M3 %M2;
                set val M2 %PV;
              else;
                if PV gt %M3;
                  set val M4 %M3;
                  set val M3 %PV;
                else;
                  if PV gt %M4;
                    set val M4 %PV;
                  end-if;
                end-if;
              end-if;
            end-if;
            get map $RX 63 PV;
            if PV gt %M1;
              set val M4 %M3;

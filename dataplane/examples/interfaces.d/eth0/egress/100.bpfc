# flags: 0x10 FEC member, 0x08 probe 1, 0x04 probe 2, 0x02 FEC on,
#        0x01 sequence restarted (first 1024 packets)
shared-buffer-map dp_eth0_arq 3000 1504;
array-map dp_eth0_atag 3000;

# Our own frames (clones re-entering egress, NAK, report, retransmission)
# pass; clear the hand-over mark so the FEC program leaves them alone.
match eth-proto 0x88B5;
  set skb-cb 0 0;
  continue;
end-match;

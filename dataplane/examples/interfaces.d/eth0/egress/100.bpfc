get ip-len IPL2;
decl IPL 8;
set val IPL %IPL2;
free IPL2;
calc-map add dp_eth0_tx 1 1 SEQ;
calc-map add dp_eth0_tx 2 1;
calc-map add dp_eth0_tx 3 %IPL;
get time NOW;
get map dp_eth0_tx 6 FK;

decl W 8;
set val W 1;
calc lsh W 61;
decl T 8;
if FK gt 0;
  # FEC on: flag 0x02 and the ratio in use (k), on every packet
  set val T 0x02;
  calc lsh T 56;
  calc or W %T;
  set val T %FK;
  calc and T 0xF;
  calc lsh T 52;
  calc or W %T;
end-if;
set val T %SEQ;
calc and T 0xFFFF;
calc lsh T 32;
calc or W %T;
# 0x01: this sequence just started (map created), lets the peer resync
if SEQ lt 1024;
  set val T 0x01;
  calc lsh T 56;
  calc or W %T;
end-if;
set val T %NOW;
calc div T 4000;
calc and T 0xFFFFFF;
calc or W %T;
free NOW;
insert-l2 8 0x88B5;
set val T %W;
calc hton T 64;
set bytes 14 8 %T;
free W;

# ARQ: keep shim + packet; tag = seq << 16 | stored length.
decl SAVE 8;
set val SAVE 1;
if FK gt 0;
  get map dp_eth0_cfg 8 MODE;
  if MODE eq 0;
    set val MODE 1;
  end-if;
  if MODE eq 2;
    set val SAVE 0;
  end-if;
  free MODE;
end-if;
if SAVE eq 1;
  set val T %SEQ;
  calc mod T 3000;
  decl SLEN 8;
  set val SLEN %IPL;
  calc add SLEN 8;
  save-packet-keyed dp_eth0_arq %T %SLEN 14 0;
  set val SAVE %SEQ;
  calc lsh SAVE 16;
  calc or SAVE %SLEN;
  set map dp_eth0_atag %T %SAVE;

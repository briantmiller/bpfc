  get map dp_eth0_tx 6 FK;
  decl NK 8;
  set val NK %FK;
  # mode: 1 = off, 2 = on, 0 or 3 = automatic
  get map dp_eth0_cfg 14 V;
  if V eq 0;
    set val V 0;

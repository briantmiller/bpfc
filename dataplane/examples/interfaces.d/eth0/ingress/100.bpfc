          set val V %TAG;
          calc add V 14;
          set len %V;
          load-packet-keyed dp_eth0_arq %T %TAG 0 14;
          # type 3 (retransmission), probe flags cleared
          get bytes 14 8 RW;
          calc lsh RW 3;
          calc rsh RW 3;
          set val V 0x0C;
          calc lsh V 56;

      get map dptqzkrr7f_cfg 9 LIM;
      if LIM eq 0;
        set val LIM 3000;
      end-if;
      if LIM gt 3000;
        set val LIM 3000;
      end-if;
    end-if;
  end-if;
  if CNT eq 0;
    drop;
  end-if;
  if CNT gt 32;
    set val CNT 32;
  end-if;
  get map dptqzkrr7f_tx 1 CUR;
  get dst-mac DM;
  get src-mac SM;
  set dst-mac %SM;
  set src-mac %DM;
  free SM;
  free DM;
  get skb-ifindex IFX;
  decl AGE 8;
  decl T 8;
  start-loop;
    # age 1 = the last packet sent; seq = next seq - age
    set val AGE %CUR;
    calc sub AGE %S;
    calc and AGE 0xFFFF;
    if AGE eq 0;
      calc-map add dptqzkrr7f_tx 14 1;
    else;
      if AGE gt %LIM;
        if AGE le 3000;
          calc-map add dptqzkrr7f_tx 15 1;
        else;
          calc-map add dptqzkrr7f_tx 14 1;
        end-if;
      else;
        set val V %CUR;
        calc sub V %AGE;
        set val T %V;
        calc mod T 3000;
        get map dptqzkrr7f_atag %T TAG;
        set val AGE %TAG;
        calc rsh AGE 16;
        if AGE eq %V;
          calc and TAG 0xFFFF;
          set val V %TAG;
          calc add V 14;
          set len %V;
          load-packet-keyed dptqzkrr7f_arq %T %TAG 0 14;
          # type 3 (retransmission), probe flags cleared
          get bytes 14 8 RW;
          calc lsh RW 3;
          calc rsh RW 3;
          set val V 0x0C;
          calc lsh V 56;
          calc not V;
          calc and RW %V;
          set val V 3;
          calc lsh V 61;
          calc or RW %V;
          calc hton RW 64;
          set bytes 14 8 %RW;
          clone %IFX egress;
          calc-map add dptqzkrr7f_tx 13 1;
        else;
          calc-map add dptqzkrr7f_tx 14 1;
        end-if;
      end-if;
    end-if;
    calc add S 1;
    calc and S 0xFFFF;
    calc sub CNT 1;
  loop CNT;
  drop;
end-if;
continue;

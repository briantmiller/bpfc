  free TR;
  get map dp_eth0_rx 16 OW;
  calc mul OW 7;
  calc add OW %T;
  calc div OW 8;
  set map dp_eth0_rx 16 %OW;
  free OW;
  # timestamp to echo in the next report (RTT), 1 << 24 marks it valid
  set val T %W;
  calc and T 0xFFFFFF;
  calc or T 0x1000000;
  set map dp_eth0_rx 21 %T;
  set map dp_eth0_rx 22 %NOW;

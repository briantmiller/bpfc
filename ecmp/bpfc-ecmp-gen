key_block() {
    # K: the flow key. PR, DSCP, SP, DP hold the fields for policies and display.
cat <<EOF
decl S 4; decl D 4; get ip-src S; get ip-dst D;
decl B1 1; decl PR 8; decl DSCP 8;
get ip-proto B1; set val PR %B1;
get ip-tos B1; set val DSCP %B1; calc rsh DSCP 2; free B1;
decl SP 8; decl DP 8; set val SP 0; set val DP 0;
EOF
    if [ "$WANT_PORTS" = 1 ]; then
cat <<'EOF'
decl FR 2; get bytes 20 2 FR; calc and FR 0x3fff;
if val %FR eq 0;
  decl PX 8; set val PX 0;
  if val %PR eq 6; set val PX 1; end-if;
  if val %PR eq 17; set val PX 1; end-if;
  if val %PR eq 132; set val PX 1; end-if;
  if val %PX eq 1;
    decl OF 8; get l4-off OF; get bytes %OF 2 SP; calc add OF 2; get bytes %OF 2 DP; free OF;
  end-if;
  free PX;
end-if;
free FR;
EOF
    fi
    echo 'decl X 8; decl Y 8; set val X %S; set val Y %D;'
    echo 'decl EP1 8; decl EP2 8; set val EP1 %SP; set val EP2 %DP;'
    if [ "$SYM" = 1 ]; then
cat <<'EOF'
decl SWP 8; set val SWP 0;
if val %X gt %Y; set val SWP 1; end-if;
if val %X eq %Y; if val %EP1 gt %EP2; set val SWP 1; end-if; end-if;
if val %SWP eq 1;
  decl TMP 8;
  set val TMP %X; set val X %Y; set val Y %TMP;
  set val TMP %EP1; set val EP1 %EP2; set val EP2 %TMP;
  free TMP;
end-if;
free SWP;
EOF
    fi
    echo 'decl K 8; set val K %X; calc lsh K 32; calc or K %Y;'
    echo 'decl E 8; set val E 0;'
    [ "$KEY_PROTO" = 0 ] || echo 'set val X %PR; calc lsh X 40; calc or E %X;'
    [ "$KEY_TOS" = 0 ] || echo 'set val X %DSCP; calc lsh X 32; calc or E %X;'
    [ "$KEY_PORTS" = 0 ] || echo 'set val X %EP1; calc lsh X 16; calc or X %EP2; calc or E %X;'
cat <<EOF
calc mul K $C1; set val Y %K; calc rsh Y 32; calc xor K %Y;
calc mul E $C2; calc xor K %E; calc mul K $C1;
set val Y %K; calc rsh Y 29; calc xor K %Y;
calc or K 1;                                # never 0 (0 marks an empty place)
free E; free EP2; free EP1;
EOF
}

gen_selector() {  # ingress interface
    local n=$1
cat <<EOF
# bpfc-ecmp prefix=$PREFIX version=$VERSION role=selector if=$n mode=$MODE members=${#MEMBER[@]} flows=$N
$POL_HDR# Chooses the member each flow leaves by. Generated by bpfc-ecmp-gen; do not edit.
EOF
    common_consts
    cat <<EOF
const SWEEP $SWEEP; const MEMBERS ${#MEMBER[@]};
const NOMOVE_MEMBERS $NOMOVE_MASK; const NOMOVE_POLICIES $POL_NOMOVE; const STRICT_POLICIES $POL_STRICT;
const NO_SLOT 255; const STALE \$(RW_NS * 8);
EOF
cat <<'EOF'
define ftget BASE FIELD VAR;
  set val Q %$BASE; calc add Q $FIELD; get map $FT %Q $VAR;
end-define;
define ftset BASE FIELD VAL;
  set val Q %$BASE; calc add Q $FIELD; set map $FT %Q %$VAL;
end-define;
define mget SLOT FIELD VAR;
  set val Q %$SLOT; calc mul Q $MF; calc add Q $FIELD; get map $MT %Q $VAR;
end-define;
match ip;
decl TTLV 1; get bytes 22 1 TTLV;
if val %TTLV le 1; continue; end-if;
free TTLV;
decl Q 8;
EOF
    if [ -n "${SLOT[$n]+x}" ]; then
        echo "const MSLOT ${SLOT[$n]};"
        rx_block
    fi
    key_block
cat <<'EOF'
decl NOW 8; get time NOW;
free S;

# ------- find the flow (two places it can be)
decl B 8; decl H 8; decl TAG 8;
set val H 0;
set val B %K; calc and B $(N - 1); calc mul B $FW;
get map $FT %B TAG;
if val %TAG eq %K;
  set val H 1;
else;
  decl B2 8; set val B2 %K; calc and B2 $(N - 1); calc xor B2 1; calc mul B2 $FW;
  get map $FT %B2 TAG;
  if val %TAG eq %K; set val B %B2; set val H 1; end-if;
  free B2;
end-if;
free TAG;

decl SALT 8; decl IFI 8; decl CUR 8; decl ST 8; decl NEED 8; decl RSN 8; decl POL 8; decl FB 8;
set val NEED 0; set val RSN 0; set val POL 0; set val IFI 0; set val ST 0; set val FB 0;
set val CUR $NO_SLOT;
if val %H eq 1;
  ftget B $F_ASSIGN X;
  set val SALT %X; calc rsh SALT 32;
  set val IFI %X; calc and IFI 0xffffffff;
  ftget B $F_STATE ST;
  set val CUR %ST; calc and CUR 0xff;
  set val POL %ST; calc rsh POL 8; calc and POL 0xff;
else;
  set val SALT %K; calc rsh SALT 16; calc and SALT 0xffffffff;
end-if;

# ------- the route decides: every packet, the flow's own hash value
fib-lookup flow ports %SALT %D;
decl OK 8; set val OK 0;
if val %FIB_RESULT eq 0; set val OK 1; end-if;
if val %FIB_RESULT eq 7;
  get map $IFM %FIB_IFINDEX X; calc rsh X 8;
  if val %X ne 0; set val OK 1; end-if;                   # a tunnel has no neighbour entry
end-if;

if val %H eq 1;
  if val %OK eq 1; if val %FIB_IFINDEX eq %IFI;
    set val NEED 100;                                     # still a member: stay
  end-if; end-if;
  if val %NEED ne 100;
    if val %FIB_RESULT eq 7; if val %FIB_IFINDEX eq %IFI;
      calc-map add $CTR $C_NONEIGH 1;                     # right interface, ARP pending
      continue;
    end-if; end-if;
    set val X 0;
    if val %FIB_RESULT eq 0; set val X 1; end-if;
    if val %OK eq 1; set val X 1; end-if;
    if val %FIB_RESULT eq 7; set val X 1; end-if;
    if val %X eq 0; continue; end-if;                     # no route, local, needs fragmenting: the kernel's
    set val NEED 1; set val RSN $R_ROUTE;                 # the route changed
  else;
    set val NEED 0;
    # accounting for the flow
    decl LEN 8; get len LEN;
    decl PREV 8; ftget B $F_SEEN PREV;
    ftset B $F_SEEN NOW;
    set val Q %B; calc add Q $F_BYTES; calc-map add $FT %Q %LEN;
    free LEN;
    ftget B $F_BPS FB;
    decl CL 8; set val CL 0;
    ftget B $F_WIN X;
    set val Y %NOW; calc sub Y %X;
    decl TF 8; set val TF %Y; calc sub TF $FW_NS; calc rsh TF 63;
    if val %TF eq 0;
      set val CL 1;
      decl FBY 8; ftget B $F_BYTES FBY;
      ftget B $F_WBYTES X; ftset B $F_WBYTES FBY;
      calc sub FBY %X; calc mul FBY 8000000;
      calc div Y 1000; calc div FBY %Y;
      if val %FB eq 0; set val FB %FBY;
      else; if val %Y gt $(FW_NS * 4 / 1000); set val FB %FBY;
      else; calc mul FB 3; calc add FB %FBY; calc div FB 4; end-if; end-if;
      ftset B $F_BPS FB;
      ftset B $F_WIN NOW;
      free FBY;
    end-if;
    free TF;

    # A flow away from its preferred interface goes back when it can.
    if val %CL eq 1; if val %POL ne 0;
      set val X %ST; calc rsh X 16; calc and X 0xff;
      if val %X ne 1;
        ftget B $F_MOVED X;
        set val Y %NOW; calc sub Y %X;
        cfg V3 5 $D_DWELL;
        if val %Y ge %V3;                                 # try at most once per dwell
          free V3;
          set val Y %NOW; calc sub Y %PREV;
          cfg V3 6 $D_GAP;
          if val %Y ge %V3; set val NEED 3; ftset B $F_MOVED NOW; end-if;
        end-if;
        free V3;
      end-if;
    end-if; end-if;
    free CL;

    # Congestion: move this flow if it is big enough and the time is right.
    decl MV 8; mget CUR $M_MOVING MV;
    if val %MV ne 0; if val %NEED eq 0;
      cfg V1 9 $D_MOVES;
      if val %V1 ne 0;
        set val X $NOMOVE_MEMBERS; calc rsh X %CUR; calc and X 1;
        set val Y 0;
        if val %POL ne 0;
          set val Y %POL; calc sub Y 1; set val V1 $NOMOVE_POLICIES; calc rsh V1 %Y; calc and V1 1; set val Y %V1;
        end-if;
        if val %X eq 0; if val %Y eq 0;
          cfg V2 4 $D_ELEPHANT;
          if val %FB ge %V2;
            ftget B $F_MOVED X;
            set val Y %NOW; calc sub Y %X;
            cfg V3 5 $D_DWELL;
            if val %Y ge %V3;
              set val Y %NOW; calc sub Y %PREV;
              cfg V4 6 $D_GAP;
              decl GO 8; set val GO 0;
              if val %Y ge %V4; set val GO 1; end-if;
              mget CUR $M_UTIL X;
              cfg V5 3 $D_FORCE;
              if val %X ge %V5; set val GO 1; end-if;
              if val %GO eq 1;
                mget CUR $M_BUDGET X;
                set val Y %X; calc rsh Y 62;
                if val %Y eq 0;                           # not overdrawn
                  calc mul X 2;                           # a flow up to twice what is left may still go
                  if val %X ge %FB; set val NEED 2; set val RSN $R_MOVED; end-if;
                end-if;
              end-if;
              free GO; free V5; free V4;
            end-if;
            free V3;
          end-if;
          free V2;
        end-if; end-if;
      end-if;
      free V1;
    end-if; end-if;
    free MV; free PREV;
  end-if;
else;
  # ------- a new flow
  if val %OK eq 0; continue; end-if;                      # not forwardable here: the kernel's
  get map $IFM %FIB_IFINDEX X;
  if val %X eq 0;
    calc-map add $CTR $C_UNMANAGED 1;                     # not a member (or not yet seen sending)
    continue;
  end-if;
  calc and X 0xff; calc sub X 1;
  decl NS 8; set val NS %X;                               # the member the hash picked
EOF
    if [ -n "$POL_MATCH" ]; then
        printf '%s' "$POL_MATCH"
        echo 'label pol_done;'
    fi
cat <<'EOF'
  if val %POL ne 0;
    set val NEED 1; set val RSN $R_POLICY;
  else;
    cfg V1 8 $D_PLACE;
    if val %V1 eq 1;
      set val NEED 1; set val RSN $R_BALANCED;
    else;
      mget NS $M_UTIL X;
      mget NS $M_TS Y;
      decl T2 8; set val T2 %NOW; calc sub T2 %Y; calc sub T2 $STALE; calc rsh T2 63;
      calc mul X %T2;                                     # not measured lately: idle
      mget NS $M_RSV Y;
      calc add X %Y;
      set val T2 %X; calc rsh T2 63; calc xor T2 1; calc mul X %T2;    # a negative promise counts as 0
      free T2;
      cfg V2 0 $D_SHED;
      if val %X ge %V2;
        set val NEED 1; set val RSN $R_SHED;
      else;
        set val CUR %NS; set val RSN $R_HASH;
      end-if;
      free V2;
    end-if;
    free V1;
  end-if;
  free NS;
end-if;
free OK;
free DP; free SP; free DSCP; free PR;

# ------- choose a member: try hash values and see what the route offers
free IFI;
decl CH 8; set val CH $NO_SLOT;
# Everything above is only constants to the verifier on some paths; a word
# that is always 0 makes them all look alike, so the paths merge here and the
# cost stays linear in the sweep. It must be "add": "or" keeps the known bits,
# so the verifier can still tell the constants apart and the paths stay split.
get map $CTR 14 X;
calc add NEED %X; calc add RSN %X; calc add POL %X; calc add CUR %X; calc add H %X; calc add FB %X; calc add ST %X; calc add CH %X;
if val %NEED ne 0;
  calc-map add $CTR $C_SWEEP 1;
  decl SEEN 8; get map $CTR 14 SEEN;
  decl N0 8; get map $CTR 14 N0;
  decl TT 8; set val TT %K; calc and TT 0xffffffff;
  decl SL 8; decl V 8;
  # What this sweep is for, as data, so the loop body does not branch on it:
  # PM = want-room | best-rank << 8 | excluded slot << 16 | slot to keep << 24.
  decl LIMIT 8; decl PM 8;
  if val %NEED ge 2;
    cfg H1 2 $D_CLEAR; set val LIMIT %H1; free H1;
    set val PM %CUR; calc lsh PM 16; calc or PM 1;
    set val X $NO_SLOT; calc lsh X 24; calc or PM %X;
    set val X 255;
    if val %NEED eq 3; set val X %ST; calc rsh X 16; calc and X 0xff; end-if;
    calc lsh X 8; calc or PM %X;
  else;
    cfg H1 0 $D_SHED; set val LIMIT %H1; free H1;
    set val FB 0;
    set val PM %CUR; calc lsh PM 24;
    set val X $NO_SLOT; calc lsh X 16; calc or PM %X;
    set val X 255; calc lsh X 8; calc or PM %X;
  end-if;
  get map $CTR 14 X; calc add LIMIT %X; calc add PM %X; calc add FB %X;
  # Which members does this route offer? Hash values are tried; each member
  # found is noted with the value that selects it (per-CPU scratch map).
  decl SCB 8; get cpu SCB; calc mod SCB $MAXCPU; calc mul SCB $MAXM;
  repeat $SWEEP as I;
    calc add TT 0x9E3779B1; calc and TT 0xffffffff;
    fib-lookup flow ports %TT %D;
    if val %FIB_RESULT gt 7; next-repeat; end-if;
    get map $IFM %FIB_IFINDEX V;
    if val %V eq 0; next-repeat; end-if;
    if val %FIB_RESULT ne 0;
      if val %FIB_RESULT ne 7; next-repeat; end-if;
      set val X %V; calc rsh X 8;
      if val %X eq 0; next-repeat; end-if;
    end-if;
    set val SL %V; calc and SL 0xff; calc sub SL 1;
    set val X %SCB; calc add X %SL; set map $SC %X %TT;
    set val X 1; calc lsh X %SL; calc or SEEN %X;
    if val %SEEN eq $(((1 << MEMBERS) - 1)); break-repeat; end-if;
  end-repeat;

  # Still a member after the route changed: stay on it.
  set val X %PM; calc rsh X 24; calc and X 0xff;
  if val %X ne $NO_SLOT;
    set val Y %SEEN; calc rsh Y %X; calc and Y 1;
    if val %Y ne 0;
      set val CH %X; calc add X %SCB; get map $SC %X SALT;
      set val SEEN 0;
      calc-map add $CTR $C_KEPT 1;
    end-if;
  end-if;

  # Judge the members found.
  decl AS 8; decl AF 8; decl BS 8; decl BF 8;              # slot << 32 | hash value, free capacity
  get map $CTR 14 AF; get map $CTR 14 BF; get map $CTR 14 AS; get map $CTR 14 BS;
  decl CS 8; decl CSC 8;
  set val CS $NO_SLOT; calc lsh CS 32; set val CSC 0xffffffffffffff;
  get map $CTR 14 X; calc add CS %X; calc add CSC %X;
  decl RK 8; decl U 8;
  repeat $MEMBERS as I;
    set val X %SEEN; calc rsh X $I; calc and X 1;
    if val %X eq 0; next-repeat; end-if;
    set val SL $I;
    set val Y %SCB; calc add Y $I; get map $SC %Y TT;
    set val X %PM; calc rsh X 16; calc and X 0xff;
    if val %X eq $I; next-repeat; end-if;
    set val RK 1;
EOF
    if [ -n "$POL_MATCH" ]; then
cat <<EOF
    if val %POL ne 0;
      set val RK 0;
$POL_RANK      if val %RK eq 0;
        set val Y %POL; calc sub Y 1; set val X \$STRICT_POLICIES; calc rsh X %Y; calc and X 1;
        if val %X eq 1; next-repeat; end-if;
        set val RK 200;
      end-if;
    end-if;
EOF
    fi
cat <<'EOF'
    mget SL $M_UTIL U;
    mget SL $M_TS V;
    set val Y %NOW; calc sub Y %V; calc sub Y $STALE; calc rsh Y 63;   # 1: measured recently, else it is idle
    calc mul U %Y;
    mget SL $M_RSV V;
    calc add U %V;
    set val Y %U; calc rsh Y 63; calc xor Y 1; calc mul U %Y;           # a negative promise counts as 0
    mget SL $M_CAP V;                                     # V = capacity
    set val Y %FB; calc mul Y 1000; calc div Y %V;        # this flow's share of it (0 for a new flow)
    calc add Y %U; calc sub Y %LIMIT; calc rsh Y 63; calc xor Y 1;      # Y = tier: 0 has room
    set val X %PM; calc and X 1; calc and X %Y;
    if val %X ne 0; next-repeat; end-if;                  # a move needs room on the target
    set val X %PM; calc rsh X 8; calc and X 0xff;
    if val %RK ge %X; if val %X ne 255; next-repeat; end-if; end-if;
    set val X %POL; if val %X eq 0; if val %Y eq 0;
      # room, no preference: remember two at random (power of two choices)
      calc add N0 1;
      set val X %N0; calc sub X 1;
      if val %N0 gt 2; get random X; calc mod X %N0; end-if;
      set val Y 0; if val %U lt 1000; set val Y 1000; calc sub Y %U; calc mul Y %V; calc div Y 1000; end-if;
      if val %X eq 0; set val AS %SL; calc lsh AS 32; calc or AS %TT; set val AF %Y; end-if;
      if val %X eq 1; set val BS %SL; calc lsh BS 32; calc or BS %TT; set val BF %Y; end-if;
      next-repeat;
    end-if; end-if;
    calc lsh Y 40; set val X %RK; calc lsh X 32; calc or Y %X; calc or Y %U;
    if val %Y lt %CSC; set val CSC %Y; set val CS %SL; calc lsh CS 32; calc or CS %TT; end-if;
  end-repeat;
  free SCB; free PM; free LIMIT; free V; free U; free RK; free SL;

  if val %N0 gt 0;
    if val %N0 ge 2;
      get random X; calc and X 1;                         # equal free capacity: either one
      if val %BF eq %AF; if val %X eq 1; set val AS %BS; end-if; end-if;
      if val %BF gt %AF; set val AS %BS; end-if;
    end-if;
    set val CS %AS;
  end-if;
  set val X %CS; calc rsh X 32;
  if val %X ne $NO_SLOT;
    set val CH %X;
    set val SALT %CS; calc and SALT 0xffffffff;
  end-if;

  if val %CH eq $NO_SLOT;
    if val %NEED eq 1;
      if val %POL gt 0;
        set val Y %POL; calc sub Y 1; set val X $STRICT_POLICIES; calc rsh X %Y; calc and X 1;
        if val %X eq 1; calc-map add $CTR $C_STRICT 1; drop; end-if;
      end-if;
      calc-map add $CTR $C_NOMEMBER 1;
      continue;
    end-if;
    set val NEED 0;                                       # nowhere better: stay
  end-if;
  free TT; free CSC; free CS; free BF; free BS; free AF; free AS; free N0; free SEEN;
  fib-lookup flow ports %SALT %D;                         # the sweep overwrote the results
else;
  if val %H eq 0; set val CH %CUR; end-if;                # a new flow on its hash
end-if;

# ------- forward on the chosen hash value
decl FWD 8; set val FWD 0;
if val %FIB_RESULT eq 0; set val FWD 1; end-if;
if val %FIB_RESULT eq 7;
  get map $IFM %FIB_IFINDEX X;
  set val Y %X; calc rsh Y 8;
  if val %Y ne 0; set val FWD 2; end-if;                  # tunnel: the kernel removes the Ethernet header
end-if;
if val %FWD eq 0;
  if val %FIB_RESULT eq 7; calc-map add $CTR $C_NONEIGH 1; end-if;
  continue;
end-if;

# ------- record what was decided
if val %CH ne $NO_SLOT;
@METABLOCK@
  if val %H eq 0;
    # a place for the new flow: free or idle, in either of its two positions
    calc-map add $CTR $C_NEW 1;
    cfg V8 7 $D_IDLE;
    decl B2 8; set val B2 %K; calc and B2 $(N - 1); calc xor B2 1; calc mul B2 $FW;
    set val H 2;
    get map $FT %B X;
    if val %X eq 0; set val H 1; end-if;
    if val %H eq 2;
      ftget B $F_SEEN X; set val Y %NOW; calc sub Y %X;
      if val %Y ge %V8; set val H 1; end-if;
    end-if;
    if val %H eq 2;
      set val B %B2;
      get map $FT %B X;
      if val %X eq 0; set val H 1; end-if;
      if val %H eq 2;
        ftget B $F_SEEN X; set val Y %NOW; calc sub Y %X;
        if val %Y ge %V8; set val H 1; end-if;
      end-if;
    end-if;
    free B2; free V8;
    if val %H eq 1;
      set val X 0; ftset B $F_TAG X;
      ftset B $F_ADDR ADDR; ftset B $F_META META;
      set val X 0; ftset B $F_BYTES X; ftset B $F_WBYTES X; ftset B $F_BPS X; ftset B $F_MOVED X;
      ftset B $F_WIN NOW; ftset B $F_SEEN NOW; ftset B $F_FIRST NOW;
      decl LEN 8; get len LEN; set val Q %B; calc add Q $F_BYTES; calc-map add $FT %Q %LEN; free LEN;
      set val ST 0;
    else;
      calc-map add $CTR $C_COLLIDE 1;                     # table full here: it keeps its hash, unrecorded
    end-if;
  end-if;
  if val %H eq 1;
    if val %NEED ge 2;
      # Pay for the move, and promise the load to the target.
      mget CUR $M_CAP X;
      set val Y %FB; calc mul Y 1000; calc div Y %X;
      calc not Y; calc add Y 1;
      set val Q %CUR; calc mul Q $MF; calc add Q $M_RSV; calc-map add $MT %Q %Y;
      mget CH $M_CAP X;
      set val Y %FB; calc mul Y 1000; calc div Y %X;
      set val Q %CH; calc mul Q $MF; calc add Q $M_RSV; calc-map add $MT %Q %Y;
      if val %NEED eq 2;
        set val Y %FB; calc not Y; calc add Y 1;
        set val Q %CUR; calc mul Q $MF; calc add Q $M_BUDGET; calc-map add $MT %Q %Y;
        calc-map add $CTR $C_MOVED 1;
      else;
        set val RSN $R_PREFERRED; calc-map add $CTR $C_PREFERRED 1;
      end-if;
      ftset B $F_MOVED NOW;
    end-if;
    if val %RSN eq $R_ROUTE;
      if val %CH eq %CUR;
        set val RSN %ST; calc rsh RSN 24; calc and RSN 0xff;  # kept: not a decision
      else;
        calc-map add $CTR $C_ROUTE 1; ftset B $F_MOVED NOW;
      end-if;
    end-if;
    if val %RSN eq $R_SHED; calc-map add $CTR $C_SHED 1; end-if;
    if val %RSN eq $R_POLICY; calc-map add $CTR $C_POLICY 1; end-if;
    # state: slot, policy, rank, reason, moves
    decl OM 8; set val OM %ST; calc rsh OM 32; calc and OM 0xffff;
    if val %NEED ge 1; if val %CUR ne $NO_SLOT; if val %CH ne %CUR; calc add OM 1; end-if; end-if; end-if;
    decl NST 8; set val NST %OM; calc lsh NST 8; calc or NST %RSN; calc lsh NST 8;
    set val RK2 0;
EOF
    # placeholder replaced below: rank of the chosen member
    cat <<'EOF'
@RANKCH@
    calc or NST %RK2; calc lsh NST 8; calc or NST %POL; calc lsh NST 8; calc or NST %CH;
    ftset B $F_STATE NST;
    set val X %SALT; calc lsh X 32; set val Y %FIB_IFINDEX; calc or X %Y;
    ftset B $F_ASSIGN X;
    ftset B $F_TAG K;
    # the event log
    # (a new flow placed by hash, policy or balance would flood it)
    set val X 0;
    if val %RSN eq $R_SHED; set val X 1; end-if;
    if val %RSN eq $R_MOVED; set val X 1; end-if;
    if val %RSN eq $R_ROUTE; set val X 1; end-if;
    if val %RSN eq $R_PREFERRED; set val X 1; end-if;
    if val %X eq 1;
      decl EVI 8; calc-map add $CTR $C_EVHEAD 1 EVI;
      calc mod EVI $EVN; calc mul EVI $EVW;
      set map $EV %EVI %NOW;
      calc add EVI 1; set map $EV %EVI %ADDR;
      calc add EVI 1; set map $EV %EVI %META;
      calc add EVI 1; set val X %CUR; calc lsh X 8; calc or X %CH; calc lsh X 8; calc or X %RSN; calc lsh X 8; calc or X %POL;
      set map $EV %EVI %X;
      calc add EVI 1; set map $EV %EVI %FB;
      free EVI;
    end-if;
    free NST; free OM;
  end-if;
  free META; free ADDR;
end-if;

# ------- the same changes any router makes
decl TV 1; decl CK 4; decl CY 4;
get bytes 22 1 TV; calc sub TV 1; set bytes 22 1 %TV;
get bytes 24 2 CK; calc add CK 0x100;
set val CY %CK; calc rsh CY 16;
calc and CK 0xffff; calc add CK %CY;
calc hton CK 16; set bytes 24 2 %CK;
if val %FWD eq 1;
  set dst-mac %FIB_DMAC; set src-mac %FIB_SMAC;
end-if;
redirect %FIB_IFINDEX egress;
end-match;
EOF
}

# ---------------------------------------------------------------- output
emit() {  # interface direction text
    local d
    if [ "$OUTDIR" = - ]; then
        echo "=== $1/$2/$PRIO.bpfc"
        cat
        return
    fi
    d=$OUTDIR/$1/$2
    mkdir -p "$d"
    cat > "$d/$PRIO.bpfc"
}

# the rank of member CH under policy POL, for the state word and "status flows"
RANKCH=""
if [ -n "$POL_RANK" ]; then
    RANKCH="    if val %POL ne 0; set val RK2 200; decl SL2 8; set val SL2 %CH;"$'\n'
    RANKCH+=$(sed 's/%SL /%SL2 /g; s/set val RK /set val RK2 /g' <<< "$POL_RANK")$'\n'
    RANKCH+="    free SL2; end-if;"
fi

meta_block() {
    echo '  decl ADDR 8; decl META 8; decl W4 4; decl W1 1; decl W2 2;'
    echo '  get ip-src W4; set val ADDR %W4; calc lsh ADDR 32; get ip-dst W4; set val Y %W4; calc or ADDR %Y;'
    echo '  get ip-proto W1; set val META %W1; calc lsh META 8; get ip-tos W1; set val Y %W1; calc rsh Y 2; calc or META %Y; calc lsh META 32;'
    if [ "$WANT_PORTS" = 1 ]; then
cat <<'XEOF'
  get bytes 20 2 W2; set val X %W2; calc and X 0x3fff;
  if val %X eq 0;
    get ip-proto W1; set val Y %W1; set val X 0;
    if val %Y eq 6; set val X 1; end-if; if val %Y eq 17; set val X 1; end-if; if val %Y eq 132; set val X 1; end-if;
    if val %X eq 1;
      get l4-off X; set val Y 0; get bytes %X 2 Y; calc lsh Y 16; calc or META %Y;
      calc add X 2; set val Y 0; get bytes %X 2 Y; calc or META %Y;
    end-if;
  end-if;
XEOF
    fi
    echo '  free W2; free W1; free W4;'
}
selector_text() {
    local t mb; t=$(gen_selector "$1"); mb=$(meta_block)
    t=${t//@METABLOCK@/$mb}
    t=${t//@RANKCH@/$RANKCH}
    # RK2 is declared where it is first used
    t=${t/"    set val RK2 0;"/"    decl RK2 8; set val RK2 0;"}
    printf '%s\n' "$t"
}

for n in "${INGRESS[@]}"; do selector_text "$n" | emit "$n" ingress; done
for n in "${MEMBER[@]}"; do
    gen_member_egress "$n" | emit "$n" egress
    in_ingress=0
    for x in "${INGRESS[@]}"; do [ "$x" = "$n" ] && in_ingress=1; done
    [ "$in_ingress" = 1 ] || gen_member_ingress "$n" | emit "$n" ingress
done
if [ "$OUTDIR" != - ]; then
    echo "Wrote programs for ${#INGRESS[@]} ingress and ${#MEMBER[@]} member interface(s) under $OUTDIR (priority $PRIO)"
fi

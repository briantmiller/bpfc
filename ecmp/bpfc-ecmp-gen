#!/bin/bash
# bpfc-ecmp-gen - generate a bandwidth-aware, policy-based ECMP layer as bpfc
# programs for /etc/bpfc/interfaces.d.
#
# The routing table stays the only authority on which next hops are valid.
# The programs choose among the members of a multipath route, per flow, using
# the measured load of each interface, and re-check the route on every packet.
# Packets change only as in any router (TTL, IP checksum, MACs), and nothing
# is needed from the neighbours.
#
# See DESIGN.md for how the pieces fit together.

set -e
VERSION=1
SELF_DIR=$(cd "$(dirname "$0")" && pwd)
PROFILE_DIRS=(/etc/bpfc/ecmp/profiles.d /usr/share/bpfc/ecmp/profiles "$SELF_DIR/profiles")
SAVE_DIR=/etc/bpfc/ecmp/profiles.d
MAX_MEMBERS=16
MAX_POLICIES=31

die()  { echo "Error: $*" >&2; exit 1; }
warn() { echo "Warning: $*" >&2; }

# ---------------------------------------------------------------- settings
# key | kind | class | default | help
#   kind:  dur (ms unless a unit is given), pct, rate, int:<min>:<max>, enum:<a>,<b>
#   class: structural (needs regenerating), runtime (also changeable with
#          "bpfc-ecmp-status set"; the cfg index is in CFGIDX)
SETTINGS='mode|enum:l3,l3+tos,l3+proto,l4,l4+tos,l3-sym,l3+tos-sym,l3+proto-sym,l4-sym,l4+tos-sym|structural|l4|what identifies a flow: addresses (l3), plus DSCP (+tos), plus protocol (+proto), plus protocol and ports (l4); -sym: both directions of a flow get the same key
flows|int:256:4194304|structural|65536|flows tracked (rounded up to a power of two)
sweep|int:0:64|structural|0|multipath hash values tried when choosing a next hop (0: 16, or 8 per member if more)
rate-interval|dur|structural|100ms|how often each interface measures its rate
flow-interval|dur|structural|200ms|how often each flow measures its rate
place|enum:hash,balanced|runtime|hash|new flows: hash (the route hash while the interface is below shed) or balanced (always pick the less loaded of two valid interfaces)
shed|pct|runtime|70|utilisation at which an interface stops taking new flows
move|pct|runtime|90|utilisation at which existing flows start moving away
clear|pct|runtime|80|flows stop moving once utilisation is below this; also the most a move may fill the target
force|pct|runtime|95|utilisation at which a flow may move without waiting for a gap
elephant|rate|runtime|1m|only flows at least this fast are moved
dwell|dur|runtime|5s|least time between two moves of one flow
gap|dur|runtime|50ms|a flow normally moves only after a pause this long, so it cannot be reordered
move-interval|dur|runtime|500ms|how often the amount of traffic to move is worked out
idle|dur|runtime|30s|a flow unseen this long may be replaced
moves|enum:on,off|runtime|on|allow moving existing flows (route changes always move them)'
declare -A CFGIDX=([shed]=0 [move]=1 [clear]=2 [force]=3 [elephant]=4 [dwell]=5 [gap]=6 [idle]=7 [place]=8 [moves]=9 [move-interval]=10)

declare -A KIND CLASS DEF HELP VAL SRC
KEYS=()
while IFS='|' read -r k kind class def help; do
    KEYS+=("$k"); KIND[$k]=$kind; CLASS[$k]=$class; DEF[$k]=$def; HELP[$k]=$help
done <<< "$SETTINGS"
is_key() { [ -n "${KIND[$1]+x}" ]; }

usage() {
cat <<EOF
Usage: $(basename "$0") --member IF=RATE [--member IF=RATE ...] --ingress IF[,IF...]
           [--policy "MATCH prefer IF[,IF...] [strict] [no-move]"]... [settings...]
       $(basename "$0") --list-profiles | --show-profile NAME
       $(basename "$0") --save-profile NAME [--description TEXT] [settings...]

Writes <outdir>/<interface>/{ingress,egress}/<priority>.bpfc.

  -M, --member IF=RATE     an egress interface and its bandwidth (k/m/g bit/s)
                           Ethernet or tunnel. Repeat, or separate with commas.
  -I, --ingress IF[,IF..]  Ethernet interfaces whose traffic is balanced
      --no-move IF[,IF..]  never move flows off these (a different NAT or
                           public address per interface, for example)
      --policy SPEC        match -> interface preference, first match wins:
                             src PREFIX | dst PREFIX | dscp N[-M] | proto N
                             sport N[-M] | dport N[-M] | iif IF
                             prefer IF[,IF...] [strict] [no-move]
                           strict: only the listed interfaces, else the packet
                           is dropped. Otherwise any valid member is the
                           fallback.
  -o, --outdir DIR         default /etc/bpfc/interfaces.d (- for stdout)
  -P, --prefix NAME        map name prefix (1-10 of A-Za-z0-9_.), default em
  -b, --priority N         TC priority of every program, default 400
  -p, --profile NAME       start from a profile (see --list-profiles)
      --profile-dir DIR    also look for profiles in DIR (searched first)
      --list-profiles      list the available profiles
      --show-profile NAME  print every effective setting and where it comes from
      --save-profile NAME  save --profile and the settings given as a new profile
      --description TEXT   description for --save-profile
      --setup-hints        print the sysctls this needs
      --remove-maps        delete the pinned maps (remove the programs first)
  -m, --map-dir DIR        pinned maps, for --remove-maps (default /sys/fs/bpf)

Settings (--name value or --name=value; the same names in profiles):
EOF
    local k
    for k in "${KEYS[@]}"; do
        printf "  --%-16s %s [%s]\n" "$k" "${HELP[$k]}" "${DEF[$k]}"
    done
cat <<EOF
Durations take us, ms, s or m (a bare number is ms); rates take k, m or g.

Needs net.ipv4.fib_multipath_hash_policy=1 and net.ipv4.ip_forward=1.
IPv4 only: other packets are left to the kernel.
EOF
}

# ---------------------------------------------------------------- units
parse_rate() {
    local v=${1,,}
    v=${v%/s}; v=${v%bps}; v=${v%bit}; v=${v%b}
    [[ "$v" =~ ^([0-9]+(\.[0-9]+)?)([kmgt]?)$ ]] || return 1
    awk -v n="${BASH_REMATCH[1]}" -v u="${BASH_REMATCH[3]}" \
        'BEGIN{m=(u=="k")?1e3:(u=="m")?1e6:(u=="g")?1e9:(u=="t")?1e12:1; printf "%.0f\n", n*m}'
}
# duration -> ns
parse_dur_ns() {
    local v=${1,,}
    [[ "$v" =~ ^([0-9]+(\.[0-9]+)?)(us|ms|s|m)?$ ]] || return 1
    awk -v n="${BASH_REMATCH[1]}" -v u="${BASH_REMATCH[3]:-ms}" \
        'BEGIN{m=(u=="us")?1e3:(u=="ms")?1e6:(u=="s")?1e9:6e10; printf "%.0f\n", n*m}'
}
valid_ifname() { [[ ${#1} -ge 1 && ${#1} -le 15 && "$1" != *[/:%[:space:]]* ]]; }

check_value() {   # key value: dies if the value does not fit the key
    local k=$1 v=$2 kind=${KIND[$1]} list min max
    case $kind in
    dur)  parse_dur_ns "$v" >/dev/null || die "--$k: not a duration: $v" ;;
    rate) parse_rate "$v" >/dev/null || die "--$k: not a rate: $v" ;;
    pct)  [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge 1 ] && [ "$v" -le 100 ] || die "--$k: 1-100, not $v" ;;
    int:*) IFS=: read -r _ min max <<< "$kind"
          [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge "$min" ] && [ "$v" -le "$max" ] || die "--$k: $min-$max, not $v" ;;
    enum:*) list=,${kind#enum:},; [[ "$list" == *,"$v",* ]] || die "--$k: one of ${kind#enum:}, not $v" ;;
    esac
}

# ---------------------------------------------------------------- arguments
MEMBERS_RAW=(); INGRESS_RAW=(); NOMOVE_RAW=(); POLICY_RAW=()
OUTDIR=/etc/bpfc/interfaces.d; PREFIX=em; PRIO=400; MAP_DIR=/sys/fs/bpf
PROFILE=; DESC=; ACTION=generate; ACTION_ARG=
declare -A CLI

add_member()  { MEMBERS_RAW+=("$1"); }

# profile <name> [depth]: applies its keys (lowest priority first: inherit)
find_profile() {
    local d
    for d in "${PROFILE_DIRS[@]}"; do [ -f "$d/$1.profile" ] && { echo "$d/$1.profile"; return 0; }; done
    return 1
}
load_profile() {
    local name=$1 depth=${2:-0} f k v line
    [ "$depth" -le 8 ] || die "profile $name: inherit is nested too deep (or a loop)"
    f=$(find_profile "$name") || die "no profile named $name"
    local parent; parent=$(awk -F= '/^[ \t]*inherit[ \t]*=/{gsub(/[ \t]/,"",$2); print $2; exit}' "$f")
    [ -z "$parent" ] || load_profile "$parent" $((depth + 1))
    while IFS= read -r line; do
        line=${line%%#*}
        [[ "$line" == *=* ]] || continue
        k=${line%%=*}; v=${line#*=}
        k=${k//[[:space:]]/}; v=$(sed 's/^[ \t]*//; s/[ \t]*$//' <<< "$v")
        case $k in
        inherit|description) ;;
        member)  add_member "$v" ;;
        ingress) INGRESS_RAW+=("$v") ;;
        no-move) NOMOVE_RAW+=("$v") ;;
        policy)  POLICY_RAW+=("$v") ;;
        *) is_key "$k" || die "profile $name: unknown setting $k"
           check_value "$k" "$v"; VAL[$k]=$v; SRC[$k]="profile $name" ;;
        esac
    done < "$f"
}

ARGS=("$@")
# the profile comes first, wherever it is on the command line
for ((i = 0; i < ${#ARGS[@]}; i++)); do
    case ${ARGS[i]} in
    --profile-dir) PROFILE_DIRS=("${ARGS[i+1]}" "${PROFILE_DIRS[@]}") ;;
    --profile-dir=*) PROFILE_DIRS=("${ARGS[i]#*=}" "${PROFILE_DIRS[@]}") ;;
    -p|--profile) PROFILE=${ARGS[i+1]} ;;
    --profile=*) PROFILE=${ARGS[i]#*=} ;;
    esac
done

for k in "${KEYS[@]}"; do VAL[$k]=${DEF[$k]}; SRC[$k]=default; done

CLI_MEMBERS=(); CLI_INGRESS=(); CLI_NOMOVE=(); CLI_POLICY=()
while [ $# -gt 0 ]; do
    a=$1; v=
    case $a in
    --*=*) v=${a#*=}; a=${a%%=*}; set -- "$a" "$v" "${@:2}" ;;
    esac
    case $a in
    -h|--help) usage; exit 0 ;;
    -M|--member)  [ $# -ge 2 ] || die "$a needs a value"; CLI_MEMBERS+=("$2"); shift 2 ;;
    -I|--ingress) [ $# -ge 2 ] || die "$a needs a value"; CLI_INGRESS+=("$2"); shift 2 ;;
    --no-move)    [ $# -ge 2 ] || die "$a needs a value"; CLI_NOMOVE+=("$2"); shift 2 ;;
    --policy)     [ $# -ge 2 ] || die "$a needs a value"; CLI_POLICY+=("$2"); shift 2 ;;
    -o|--outdir)  OUTDIR=$2; shift 2 ;;
    -P|--prefix)  PREFIX=$2; shift 2 ;;
    -b|--priority) PRIO=$2; shift 2 ;;
    -m|--map-dir) MAP_DIR=$2; shift 2 ;;
    -p|--profile|--profile-dir) shift 2 ;;
    --list-profiles) ACTION=list; shift ;;
    --show-profile) ACTION=show; ACTION_ARG=$2; shift 2 ;;
    --save-profile) ACTION=save; ACTION_ARG=$2; shift 2 ;;
    --description) DESC=$2; shift 2 ;;
    --setup-hints) ACTION=hints; shift ;;
    --remove-maps) ACTION=remove; shift ;;
    --*) k=${a#--}; is_key "$k" || die "unknown option $a (see --help)"
         [ $# -ge 2 ] || die "$a needs a value"
         check_value "$k" "$2"; CLI[$k]=$2; shift 2 ;;
    *) die "unexpected argument: $a (see --help)" ;;
    esac
done

[[ "$PREFIX" =~ ^[A-Za-z0-9_.]{1,10}$ ]] || die "--prefix: 1-10 of A-Za-z0-9_.: $PREFIX"
[[ "$PRIO" =~ ^[0-9]+$ ]] && [ "$PRIO" -ge 1 ] && [ "$PRIO" -le 65535 ] || die "--priority: 1-65535: $PRIO"

MAP_NAMES=(ft m if cfg ctr ev sc)

case $ACTION in
hints)
cat <<EOF
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv4.fib_multipath_hash_policy=1
# On a routing daemon's ECMP routes, drop a next hop as soon as its link goes:
sysctl -w net.ipv4.conf.all.ignore_routes_with_linkdown=1
EOF
    exit 0 ;;
list)
    seen=" "
    for d in "${PROFILE_DIRS[@]}"; do
        for f in "$d"/*.profile; do
            [ -f "$f" ] || continue
            n=$(basename "$f" .profile)
            [[ "$seen" == *" $n "* ]] && continue
            seen+="$n "
            printf "%-16s %s\n" "$n" "$(awk -F= '/^[ \t]*description[ \t]*=/{sub(/^[ \t]*/,"",$2); print $2; exit}' "$f")"
        done
    done
    exit 0 ;;
remove)
    for m in "${MAP_NAMES[@]}"; do rm -f "$MAP_DIR/${PREFIX}_$m"; done
    exit 0 ;;
esac

if [ "$ACTION" = show ]; then PROFILE=$ACTION_ARG; fi
[ -z "$PROFILE" ] || load_profile "$PROFILE"
for k in "${!CLI[@]}"; do VAL[$k]=${CLI[$k]}; SRC[$k]="command line"; done
# The command line replaces a profile's interfaces and policies.
[ ${#CLI_MEMBERS[@]} -eq 0 ] || MEMBERS_RAW=("${CLI_MEMBERS[@]}")
[ ${#CLI_INGRESS[@]} -eq 0 ] || INGRESS_RAW=("${CLI_INGRESS[@]}")
[ ${#CLI_NOMOVE[@]} -eq 0 ] || NOMOVE_RAW=("${CLI_NOMOVE[@]}")
[ ${#CLI_POLICY[@]} -eq 0 ] || POLICY_RAW=("${CLI_POLICY[@]}")

if [ "$ACTION" = show ]; then
    for k in "${KEYS[@]}"; do printf "%-16s %-10s (%s)\n" "$k" "${VAL[$k]}" "${SRC[$k]}"; done
    for m in "${MEMBERS_RAW[@]}"; do echo "member           $m"; done
    for m in "${INGRESS_RAW[@]}"; do echo "ingress          $m"; done
    for m in "${NOMOVE_RAW[@]}"; do echo "no-move          $m"; done
    for m in "${POLICY_RAW[@]}"; do echo "policy           $m"; done
    exit 0
fi
if [ "$ACTION" = save ]; then
    [[ "$ACTION_ARG" =~ ^[A-Za-z0-9_.-]+$ ]] || die "bad profile name: $ACTION_ARG"
    d=${PROFILE_DIRS[0]}
    mkdir -p "$d"; f=$d/$ACTION_ARG.profile
    {
        [ -z "$DESC" ] || echo "description = $DESC"
        [ -z "$PROFILE" ] || echo "inherit = $PROFILE"
        for k in "${KEYS[@]}"; do [ -z "${CLI[$k]+x}" ] || echo "$k = ${CLI[$k]}"; done
        for m in "${CLI_MEMBERS[@]}"; do echo "member = $m"; done
        for m in "${CLI_INGRESS[@]}"; do echo "ingress = $m"; done
        for m in "${CLI_NOMOVE[@]}"; do echo "no-move = $m"; done
        for m in "${CLI_POLICY[@]}"; do echo "policy = $m"; done
    } > "$f"
    echo "$f"
    exit 0
fi

# ---------------------------------------------------------------- interfaces
declare -A SLOT CAP
MEMBER=()
for spec in "${MEMBERS_RAW[@]}"; do
    IFS=, read -ra parts <<< "$spec"
    for p in "${parts[@]}"; do
        [[ "$p" == *=* ]] || die "--member needs IF=RATE: $p"
        n=${p%%=*}; r=${p#*=}
        valid_ifname "$n" || die "--member: bad interface name: $n"
        [ -z "${SLOT[$n]+x}" ] || die "--member: $n given twice"
        b=$(parse_rate "$r") || die "--member $n: not a rate: $r"
        [ "$b" -gt 0 ] || die "--member $n: rate must be above 0"
        SLOT[$n]=${#MEMBER[@]}; CAP[$n]=$b; MEMBER+=("$n")
    done
done
[ ${#MEMBER[@]} -ge 2 ] || die "at least two --member interfaces are needed"
[ ${#MEMBER[@]} -le $MAX_MEMBERS ] || die "at most $MAX_MEMBERS members"
INGRESS=()
for s in "${INGRESS_RAW[@]}"; do
    IFS=, read -ra parts <<< "$s"
    for n in "${parts[@]}"; do
        valid_ifname "$n" || die "--ingress: bad interface name: $n"
        for x in "${INGRESS[@]}"; do [ "$x" != "$n" ] || die "--ingress: $n given twice"; done
        INGRESS+=("$n")
        t=/sys/class/net/$n/type
        if [ -r "$t" ] && [ "$(cat "$t")" != 1 ]; then
            die "--ingress $n: only Ethernet interfaces can steer traffic (device type $(cat "$t")): fib-lookup needs an Ethernet header. Traffic arriving on it is still counted at the members, and routed by the kernel"
        fi
    done
done
[ ${#INGRESS[@]} -ge 1 ] || die "at least one --ingress interface is needed"
NOMOVE_MASK=0
for s in "${NOMOVE_RAW[@]}"; do
    IFS=, read -ra parts <<< "$s"
    for n in "${parts[@]}"; do
        [ -n "${SLOT[$n]+x}" ] || die "--no-move: $n is not a member"
        NOMOVE_MASK=$((NOMOVE_MASK | (1 << SLOT[$n])))
    done
done

v() { echo "${VAL[$1]}"; }
ns() { parse_dur_ns "${VAL[$1]}"; }
SHED=$(( $(v shed) * 10 )); MOVE=$(( $(v move) * 10 )); CLEAR=$(( $(v clear) * 10 )); FORCE=$(( $(v force) * 10 ))
[ "$CLEAR" -lt "$MOVE" ] || die "--clear ($(v clear)) must be below --move ($(v move))"
[ "$MOVE" -le "$FORCE" ] || die "--force ($(v force)) must not be below --move ($(v move))"
[ "$SHED" -le "$MOVE" ] || die "--shed ($(v shed)) must not be above --move ($(v move))"
MODE=$(v mode)
SYM=0; [[ "$MODE" == *-sym ]] && SYM=1
M=${MODE%-sym}
KEY_TOS=0; [[ "$M" == *+tos ]] && KEY_TOS=1
KEY_PROTO=0; [[ "$M" == l3+proto ]] && KEY_PROTO=1
KEY_PORTS=0; [[ "$M" == l4* ]] && { KEY_PORTS=1; KEY_PROTO=1; }
FLOWS=$(v flows); N=256; while [ "$N" -lt "$FLOWS" ]; do N=$((N * 2)); done
SWEEP=$(v sweep)
if [ "$SWEEP" = 0 ]; then
    SWEEP=$(( ${#MEMBER[@]} * 8 )); [ "$SWEEP" -ge 16 ] || SWEEP=16; [ "$SWEEP" -le 64 ] || SWEEP=64
fi

# ---------------------------------------------------------------- policies
POL_MATCH=""; POL_RANK=""; POL_STRICT=0; POL_NOMOVE=0; POL_HDR=""; WANT_PORTS=$KEY_PORTS
# port_cond VAR N[-M]: the two-sided comparison as bpfc "if" lines
port_cond() {
    local var=$1 r=$2 lo hi
    [[ "$r" =~ ^([0-9]+)(-([0-9]+))?$ ]] || die "--policy: not a number or range: $r"
    lo=${BASH_REMATCH[1]}; hi=${BASH_REMATCH[3]:-$lo}
    [ "$lo" -le "$hi" ] || die "--policy: empty range: $r"
    echo "if val %$var ge $lo; if val %$var le $hi;"
}
PNUM=0
for spec in "${POLICY_RAW[@]}"; do
    PNUM=$((PNUM + 1))
    [ $PNUM -le $MAX_POLICIES ] || die "at most $MAX_POLICIES policies"
    read -ra w <<< "$spec"
    open=""; close=""; prefer=""; strict=0; nomove=0; i=0
    while [ $i -lt ${#w[@]} ]; do
        kw=${w[i]}; arg=${w[i+1]:-}
        case $kw in
        strict) strict=1; i=$((i + 1)); continue ;;
        no-move) nomove=1; i=$((i + 1)); continue ;;
        esac
        [ -n "$arg" ] || die "--policy: $kw needs a value: $spec"
        case $kw in
        src) open+="match ip-src $arg; "; close="end-match; $close" ;;
        dst) open+="match ip-dst $arg; "; close="end-match; $close" ;;
        dscp) c=$(port_cond DSCP "$arg"); open+="$c "; close="end-if; end-if; $close"
              [ "$KEY_TOS" = 1 ] || WARN_TOS=1 ;;
        proto) [[ "$arg" =~ ^[0-9]+$ ]] && [ "$arg" -le 255 ] || die "--policy: proto is a number: $arg"
              open+="if val %PR eq $arg; "; close="end-if; $close" ;;
        sport|dport) [ "$KEY_PORTS" = 1 ] || die "--policy: $kw needs a mode that includes ports (l4, l4+tos), not $MODE"
              v2=SP; [ "$kw" = dport ] && v2=DP
              c=$(port_cond $v2 "$arg"); open+="$c "; close="end-if; end-if; $close" ;;
        iif)  open+="when \$IFNAME == $arg; "; close="end-when; $close" ;;
        prefer) prefer=$arg ;;
        *) die "--policy: unknown keyword $kw: $spec" ;;
        esac
        i=$((i + 2))
    done
    [ -n "$prefer" ] || die "--policy: no prefer list: $spec"
    POL_MATCH+="  ${open}set val POL $PNUM; goto pol_done; ${close}"$'\n'
    POL_RANK+="        if val %POL eq $PNUM;"
    IFS=, read -ra pf <<< "$prefer"; rank=0
    for n in "${pf[@]}"; do
        [ -n "${SLOT[$n]+x}" ] || die "--policy: $n is not a member: $spec"
        rank=$((rank + 1))
        POL_RANK+=" if val %SL eq ${SLOT[$n]}; set val RK $rank; end-if;"
    done
    POL_RANK+=" end-if;"$'\n'
    [ "$strict" = 0 ] || POL_STRICT=$((POL_STRICT | (1 << (PNUM - 1))))
    [ "$nomove" = 0 ] || POL_NOMOVE=$((POL_NOMOVE | (1 << (PNUM - 1))))
    POL_HDR+="# bpfc-ecmp policy=$PNUM $spec"$'\n'
done
# Roughly what the verifier will take (kernel 6.18), against its limit of 1M.
n=${#MEMBER[@]}; COST=$(( 30000 + 11000 * (n < 8 ? n : 8) + 2000 * (n > 8 ? n - 8 : 0) + PNUM * (8000 + 1200 * n) ))
[ "$COST" -lt 900000 ] || warn "${#MEMBER[@]} members and $PNUM policies may exceed the verifier limit when loaded; if so, fewer of either"
[ -z "${WARN_TOS:-}" ] || warn "a policy matches DSCP but mode $MODE does not: a flow takes the policy of its first packet's DSCP"

# ---------------------------------------------------------------- program text
FW=12        # words per flow
MF=24        # words per member
C1=0x9E3779B97F4A7C15; C2=0xC2B2AE3D27D4EB4F

common_consts() {
cat <<EOF
const FT ${PREFIX}_ft; const MT ${PREFIX}_m; const IFM ${PREFIX}_if;
const CFG ${PREFIX}_cfg; const CTR ${PREFIX}_ctr; const EV ${PREFIX}_ev; const SC ${PREFIX}_sc; const MAXCPU 256;
const N $N; const FW $FW; const MF $MF; const MAXM $MAX_MEMBERS;
const EVN 256; const EVW 5;
array-map \$FT \$(N * FW);
array-map \$MT \$(MAXM * MF);
array-map \$CFG 32;
array-map \$CTR 16;
array-map \$EV \$(EVN * EVW);
array-map \$SC \$(MAXCPU * MAXM);
# flow words
const F_TAG 0; const F_ADDR 1; const F_META 2; const F_ASSIGN 3; const F_BYTES 4;
const F_WIN 5; const F_WBYTES 6; const F_BPS 7; const F_SEEN 8; const F_STATE 9;
const F_MOVED 10; const F_FIRST 11;
# member words
const M_CAP_SET 0; const M_CAP 1; const M_TXB 2; const M_PREVB 3; const M_WIN 4;
const M_TS 5; const M_RATE 6; const M_UTIL 7; const M_RSV 8; const M_BUDGET 9;
const M_MOVING 10; const M_BTS 11; const M_TXP 12; const M_IFINDEX 13;
const M_RXB 15; const M_RXPREV 16; const M_RXRATE 17; const M_RXWIN 18; const M_RXTS 19; const M_RXP 20;
# counters
const C_NEW 0; const C_SHED 1; const C_MOVED 2; const C_ROUTE 3; const C_POLICY 4;
const C_COLLIDE 5; const C_NOMEMBER 6; const C_UNMANAGED 7; const C_NONEIGH 8;
const C_STRICT 9; const C_EVHEAD 10; const C_SWEEP 11; const C_PREFERRED 12; const C_KEPT 13;
# reasons
const R_HASH 1; const R_SHED 2; const R_POLICY 3; const R_BALANCED 4; const R_MOVED 5;
const R_ROUTE 6; const R_PREFERRED 7;
# settings: stored + 1 at run time, 0 = the value generated here
const D_SHED $SHED; const D_MOVE $MOVE; const D_CLEAR $CLEAR; const D_FORCE $FORCE;
const D_ELEPHANT $(parse_rate "$(v elephant)"); const D_DWELL $(ns dwell); const D_GAP $(ns gap);
const D_IDLE $(ns idle); const D_PLACE $([ "$(v place)" = balanced ] && echo 1 || echo 0);
const D_MOVES $([ "$(v moves)" = on ] && echo 1 || echo 0); const D_MOVEINT $(ns move-interval);
const RW_NS $(ns rate-interval); const FW_NS $(ns flow-interval);
define cfg VAR IDX DEF;
  decl \$VAR 8; decl CFGT 8; get map \$CFG \$IDX \$VAR;
  set val CFGT %\$VAR; calc sub \$VAR 1; calc sub CFGT 1; calc rsh CFGT 63;
  calc mul CFGT \$(DEF + 1); calc add \$VAR %CFGT; free CFGT;
end-define;
EOF
}

# rx-count SLOT: counts what a member receives (shown, never acted on)
rx_block() {
cat <<'EOF'
decl RXL 8; get len RXL;
decl RXN 8; get time RXN;
calc-map add $MT $(MSLOT * MF + M_RXB) %RXL;
calc-map add $MT $(MSLOT * MF + M_RXP) 1;
decl RXW 8; set val RXW %RXN; calc div RXW $RW_NS;
decl RXO 8; calc-map xchg $MT $(MSLOT * MF + M_RXWIN) %RXW RXO;
if val %RXO ne %RXW;
  decl RXB 8; get map $MT $(MSLOT * MF + M_RXB) RXB;
  decl RXP 8; calc-map xchg $MT $(MSLOT * MF + M_RXPREV) %RXB RXP;
  decl RXT 8; calc-map xchg $MT $(MSLOT * MF + M_RXTS) %RXN RXT;
  if val %RXT ne 0;
    decl RXD 8; set val RXD %RXN; calc sub RXD %RXT; calc div RXD 1000;
    calc sub RXB %RXP; calc mul RXB 8000000; calc div RXB %RXD;
    decl RXR 8; get map $MT $(MSLOT * MF + M_RXRATE) RXR;
    if val %RXD gt $(RW_NS * 4 / 1000); set val RXR %RXB;
    else; calc mul RXR 3; calc add RXR %RXB; calc div RXR 4; end-if;
    set map $MT $(MSLOT * MF + M_RXRATE) %RXR;
    free RXR; free RXD;
  end-if;
  free RXT; free RXP; free RXB;
end-if;
free RXO; free RXW; free RXN; free RXL;
EOF
}

gen_member_egress() {   # member
    local n=$1
cat <<EOF
# bpfc-ecmp prefix=$PREFIX version=$VERSION role=member slot=${SLOT[$n]} if=$n cap=${CAP[$n]}
# Counts what leaves $n and works out its rate, utilisation and how much
# traffic should move. Generated by bpfc-ecmp-gen; do not edit.
EOF
    common_consts
cat <<EOF
const MSLOT ${SLOT[$n]}; const CAP_DEF ${CAP[$n]};
EOF
cat <<'EOF'
decl LEN 8; get len LEN;
calc-map add $MT $(MSLOT * MF + M_TXB) %LEN;
calc-map add $MT $(MSLOT * MF + M_TXP) 1;
decl NOW 8; get time NOW;
decl W 8; set val W %NOW; calc div W $RW_NS;
decl OLDW 8; calc-map xchg $MT $(MSLOT * MF + M_WIN) %W OLDW;
if val %OLDW ne %W;                        # first packet of this window, on any CPU
  decl BY 8; get map $MT $(MSLOT * MF + M_TXB) BY;
  decl PB 8; calc-map xchg $MT $(MSLOT * MF + M_PREVB) %BY PB;
  decl TS 8; calc-map xchg $MT $(MSLOT * MF + M_TS) %NOW TS;
  decl C 8; get map $MT $(MSLOT * MF + M_CAP_SET) C;
  if val %C eq 0; set val C $CAP_DEF; end-if;
  set map $MT $(MSLOT * MF + M_CAP) %C;
  when $L3OFF == 0;
    const IFVAL $((MSLOT + 1) | 256);
  otherwise;
    const IFVAL $(MSLOT + 1);
  end-when;
  decl IFI 8; get skb-ifindex IFI;
  set map $IFM %IFI $IFVAL;
  set map $MT $(MSLOT * MF + M_IFINDEX) %IFI;
  if val %TS ne 0;
    decl DT 8; set val DT %NOW; calc sub DT %TS; calc div DT 1000;
    calc sub BY %PB; calc mul BY 8000000; calc div BY %DT;       # bit/s this window
    decl R 8; get map $MT $(MSLOT * MF + M_RATE) R;
    if val %DT gt $(RW_NS * 4 / 1000); set val R %BY;            # idle for a while
    else; calc mul R 3; calc add R %BY; calc div R 4; end-if;
    set map $MT $(MSLOT * MF + M_RATE) %R;
    decl U 8; set val U %R; calc mul U 1000; calc div U %C;
    set map $MT $(MSLOT * MF + M_UTIL) %U;
    decl Z 8; set val Z 0; calc-map xchg $MT $(MSLOT * MF + M_RSV) %Z Z;   # what was promised is now measured
    # Move hysteresis, and how much traffic should leave.
    decl MV 8; get map $MT $(MSLOT * MF + M_MOVING) MV;
    cfg TH 1 $D_MOVE;
    if val %U ge %TH; set val MV 1; end-if;
    cfg CL 2 $D_CLEAR;
    if val %U lt %CL; set val MV 0; end-if;
    set map $MT $(MSLOT * MF + M_MOVING) %MV;
    decl BT 8; get map $MT $(MSLOT * MF + M_BTS) BT;
    decl EL 8; set val EL %NOW; calc sub EL %BT;
    cfg MI 10 $D_MOVEINT;
    if val %EL ge %MI;
      set map $MT $(MSLOT * MF + M_BTS) %NOW;
      decl BG 8; set val BG 0;
      if val %MV ne 0;
        decl TG 8; set val TG %C; calc mul TG %CL; calc div TG 1000;
        if val %R gt %TG; set val BG %R; calc sub BG %TG; end-if;
      end-if;
      set map $MT $(MSLOT * MF + M_BUDGET) %BG;
    end-if;
  end-if;
end-if;
EOF
}

